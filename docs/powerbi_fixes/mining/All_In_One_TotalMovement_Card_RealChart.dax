All_In_One_TotalMovement_Card_RealChart = 
// ==========================================
// PERBAIKAN: titik legend 'Cumm Plan' merah, sama dengan garisnya (sebelumnya hijau #84CC16)
// 0. DETEKSI TANGGAL (ANTI BUG / ANTI BOLONG)
// ==========================================
// Ambil tanggal maksimal dari slicer. Jika kosong, gunakan hari ini.
VAR _RawMaxDate = MAX('mpx_daily_pondok_view'[report_date])
VAR _SafeMaxDate = COALESCE(_RawMaxDate, TODAY())
// Memaksa selalu mengambil tanggal 1 di bulan dan tahun yang sama
VAR _SafeMinDate = DATE(YEAR(_SafeMaxDate), MONTH(_SafeMaxDate), 1) 
// Buat urutan tanggal utuh tanpa bolong
VAR _DateTable = CALENDAR(_SafeMinDate, _SafeMaxDate) 
VAR _TotalDays = MAX(1, CONVERT(_SafeMaxDate - _SafeMinDate, INTEGER) + 1)

// ==========================================
// 1. KALKULASI DATA TOTAL
// ==========================================
VAR _MTDActual_Raw = 
    CALCULATE(
        SUM('mpx_daily_pondok_view'[actual]),
        'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"},
        'mpx_daily_pondok_view'[unit] = "ton",
        'mpx_daily_pondok_view'[report_date] >= _SafeMinDate,
        'mpx_daily_pondok_view'[report_date] <= _SafeMaxDate
    )

VAR _MTDPlan_Raw = 
    CALCULATE(
        SUM('mpx_daily_pondok_view'[lomp]),
        'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"},
        'mpx_daily_pondok_view'[unit] = "ton",
        'mpx_daily_pondok_view'[report_date] >= _SafeMinDate,
        'mpx_daily_pondok_view'[report_date] <= _SafeMaxDate
    )

VAR _MTDPlan = DIVIDE(_MTDPlan_Raw, 1000, 0)
VAR _MTDActual = DIVIDE(_MTDActual_Raw, 1000, 0)
VAR _AchievePct = DIVIDE(_MTDActual, _MTDPlan, 0)
VAR _PctText = FORMAT(_AchievePct, "0%")

VAR _Circum = 251.2
VAR _Dash = _AchievePct * _Circum

// ==========================================
// 2. SVG CHART GENERATOR (DUAL AUTO-SCALE)
// ==========================================
VAR _GridHeight = 150 // Area Grid / Bar Chart
VAR _SvgHeight = 175  // Area Total SVG (ditambah 25px ke bawah untuk ruang teks tanggal)

// LEBAR DINAMIS: Setiap hari diberi ruang 45px
VAR _ChartWidth = MAX(600, _TotalDays * 45) 

// SKALA KIRI: Untuk Line Chart (Kumulatif)
VAR _MaxY_Scale = MAX( MAX(_MTDPlan, _MTDActual) * 1.1, 10 ) 

// SKALA KANAN: Untuk Bar Chart (Harian) agar tidak kekecilan
VAR _MaxDaily_Raw = 
    MAXX(
        _DateTable,
        VAR _CurDate = [Date]
        VAR _Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 'mpx_daily_pondok_view'[unit] = "ton", 'mpx_daily_pondok_view'[report_date] = _CurDate) / 1000, 0)
        VAR _Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 'mpx_daily_pondok_view'[unit] = "ton", 'mpx_daily_pondok_view'[report_date] = _CurDate) / 1000, 0)
        RETURN MAX(_Act, _Plan)
    )
VAR _MaxBar_Scale = MAX( _MaxDaily_Raw * 1.15, 2 ) // Batas Skala Bar (Ditambah 15% Padding)

// Padding X-Axis
VAR _PadX = 25
VAR _ActiveWidth = _ChartWidth - (_PadX * 2)

// 2A. Looping Titik Garis ACTUAL
VAR _ActualLinePoints = 
    CONCATENATEX(
        _DateTable,
        VAR _CurDate = [Date]
        VAR _X = (DIVIDE(CONVERT(_CurDate - _SafeMinDate, INTEGER), MAX(1, _TotalDays - 1), 0) * _ActiveWidth) + _PadX
        VAR _CumVal = 
            COALESCE(
                CALCULATE(
                    SUM('mpx_daily_pondok_view'[actual]), 
                    'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 
                    'mpx_daily_pondok_view'[unit] = "ton", 
                    ALL('mpx_daily_pondok_view'[report_date]), 
                    'mpx_daily_pondok_view'[report_date] >= _SafeMinDate, 
                    'mpx_daily_pondok_view'[report_date] <= _CurDate
                ) / 1000
            , 0)
        VAR _Y = _GridHeight - (MIN(DIVIDE(_CumVal, _MaxY_Scale, 0), 1) * _GridHeight)
        RETURN _X & "," & _Y, " ", [Date], ASC
    )

// 2B. Looping Titik Garis PLAN
VAR _PlanLinePoints = 
    CONCATENATEX(
        _DateTable,
        VAR _CurDate = [Date]
        VAR _X = (DIVIDE(CONVERT(_CurDate - _SafeMinDate, INTEGER), MAX(1, _TotalDays - 1), 0) * _ActiveWidth) + _PadX
        VAR _CumVal = 
            COALESCE(
                CALCULATE(
                    SUM('mpx_daily_pondok_view'[lomp]), 
                    'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 
                    'mpx_daily_pondok_view'[unit] = "ton", 
                    ALL('mpx_daily_pondok_view'[report_date]), 
                    'mpx_daily_pondok_view'[report_date] >= _SafeMinDate, 
                    'mpx_daily_pondok_view'[report_date] <= _CurDate
                ) / 1000
            , 0)
        VAR _Y = _GridHeight - (MIN(DIVIDE(_CumVal, _MaxY_Scale, 0), 1) * _GridHeight)
        RETURN _X & "," & _Y, " ", [Date], ASC
    )

// 2C. Looping Batang Harian & Tooltips & Tanggal
VAR _BarChartsHTML = 
    CONCATENATEX(
        _DateTable,
        VAR _CurDate = [Date]
        VAR _DateStr = FORMAT(_CurDate, "dd MMM yyyy")
        VAR _ShortDate = FORMAT(_CurDate, "dd MMM") // Format Label Sumbu X
        VAR _PctX = DIVIDE(CONVERT(_CurDate - _SafeMinDate, INTEGER), MAX(1, _TotalDays - 1), 0)
        VAR _X = (_PctX * _ActiveWidth) + _PadX
        
        VAR _DailyAct = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 'mpx_daily_pondok_view'[unit] = "ton", 'mpx_daily_pondok_view'[report_date] = _CurDate) / 1000, 0)
        VAR _DailyPlan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "hl_ore_stockpile", "hl_ore_rom", "cil_ore_stockpile", "mw", "total_outpit_movement"}, 'mpx_daily_pondok_view'[unit] = "ton", 'mpx_daily_pondok_view'[report_date] = _CurDate) / 1000, 0)
        
        // Bar diset agar mengambil maksimal 85% dari area grafik (Lebih besar dan jelas)
        VAR _HAct = MIN(DIVIDE(_DailyAct, _MaxBar_Scale, 0), 1) * (_GridHeight * 0.85)
        VAR _HPlan = MIN(DIVIDE(_DailyPlan, _MaxBar_Scale, 0), 1) * (_GridHeight * 0.85)
        
        VAR _YAct = _GridHeight - _HAct
        VAR _YPlan = _GridHeight - _HPlan
        
        VAR _TooltipAct = _DateStr & "&#10;Daily Act: " & FORMAT(_DailyAct, "#,##0.0") & " kt"
        VAR _TooltipPlan = _DateStr & "&#10;Daily Plan: " & FORMAT(_DailyPlan, "#,##0.0") & " kt"
        
        RETURN 
            "<g style='animation: fadeUp 0.6s ease-out backwards; animation-delay: " & (_PctX * 0.5) & "s;'>" &
                "<rect class='bar-act' x='" & (_X - 7) & "' y='" & _YAct & "' width='6' height='" & MAX(0, _HAct) & "' fill='#10B981' rx='1'><title>" & _TooltipAct & "</title></rect>" &
                "<rect class='bar-plan' x='" & (_X + 1) & "' y='" & _YPlan & "' width='6' height='" & MAX(0, _HPlan) & "' fill='#D1D5DB' rx='1'><title>" & _TooltipPlan & "</title></rect>" &
                "<text x='" & _X & "' y='168' font-size='9' fill='#6B7280' text-anchor='middle'>" & _ShortDate & "</text>" &
            "</g>",
        "", [Date], ASC
    )

// ==========================================
// 3. RENDER HTML CSS + ANIMATIONS
// ==========================================
RETURN
"<style>
    /* KEYFRAMES */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fillDonut { from { stroke-dasharray: 0, 251.2; } to { stroke-dasharray: " & _Dash & ", 251.2; } }
    @keyframes fadeText { from { opacity: 0; } to { opacity: 1; } }

    /* LAYOUT UTAMA */
    .aio-container { font-family: 'Segoe UI', sans-serif; background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; width: 100%; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: default; }
    .aio-container:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08); border-color: #D1D5DB; }
    
    .aio-header { padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E5E7EB; }
    .aio-title { font-size: 16px; font-weight: 600; color: #111827; }
    .aio-badge { background-color: #D1FAE5; color: #047857; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 600; transition: background 0.2s; }
    .aio-container:hover .aio-badge { background-color: #A7F3D0; }
    
    .aio-body { display: flex; flex-direction: row; flex-grow: 1; min-height: 250px; }
    .aio-chart-area { flex: 7; padding: 20px 20px 10px 20px; display: flex; flex-direction: column; overflow: hidden; }
    
    /* LEGEND */
    .aio-legend { display: flex; justify-content: center; gap: 15px; font-size: 11px; color: #6B7280; margin-bottom: 15px; align-items: center; }
    .leg-box { display: inline-block; width: 24px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
    .leg-line { display: inline-block; width: 16px; height: 2px; margin-right: 6px; vertical-align: middle; position: relative; }
    .leg-line::after { content: ''; position: absolute; top: -3px; left: 4px; width: 8px; height: 8px; border-radius: 50%; }
    
    /* CHART WRAPPER */
    .chart-layout { display: flex; flex-grow: 1; position: relative; width: 100%; align-items: flex-start; }
    
    /* SKALA KIRI FIXED */
    .y-axis-left { width: 45px; height: 155px; flex-shrink: 0; display: flex; flex-direction: column; justify-content: space-between; font-size: 10px; color: #6B7280; text-align: right; padding-right: 10px; box-sizing: border-box; margin-top: 5px; background: white; z-index: 10; }
    
    /* SKALA KANAN FIXED */
    .y-axis-right { width: 40px; height: 127.5px; flex-shrink: 0; display: flex; flex-direction: column; justify-content: space-between; font-size: 9px; color: #10B981; text-align: left; padding-left: 10px; font-weight: 600; box-sizing: border-box; margin-top: 27.5px; background: white; z-index: 10; }
    
    /* AREA SCROLL */
    .scroll-area { flex-grow: 1; overflow-x: auto; overflow-y: hidden; position: relative; padding-bottom: 10px; }
    
    /* SCROLLBAR STYLING */
    .scroll-area::-webkit-scrollbar { height: 10px; }
    .scroll-area::-webkit-scrollbar-thumb { background-color: #9CA3AF; border-radius: 5px; }
    .scroll-area::-webkit-scrollbar-thumb:hover { background-color: #6B7280; }
    .scroll-area::-webkit-scrollbar-track { background-color: #F3F4F6; border-radius: 5px; }
    
    .chart-svg-layer { display: block; overflow: visible; margin-top: 5px; }
    
    /* HOVER INTERACTION */
    .bar-act, .bar-plan { transition: fill 0.2s, transform 0.2s; cursor: pointer; }
    .bar-act:hover { fill: #059669; }
    .bar-plan:hover { fill: #9CA3AF; }
    
    .line-act, .line-plan { transition: stroke-width 0.2s ease; cursor: crosshair; }
    .line-act:hover { stroke-width: 4px; stroke: #2563EB; }
    .line-plan:hover { stroke-width: 4px; stroke: #DC2626; }
    
    /* RIGHT PANEL - UBAH BACKGROUND JADI PUTIH */
    .aio-side-panel { flex: 3; padding: 20px 20px 20px 30px; border-left: 1px solid #E5E7EB; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; background: #FFFFFF; }
    .ach-label { font-size: 12px; color: #6B7280; margin-bottom: 4px; }
    .ach-val { font-size: 16px; font-weight: 700; color: #111827; margin-bottom: 16px; animation: fadeText 1s ease-in forwards; }
    
    .donut-svg { transform: rotate(-90deg); width: 120px; height: 120px; align-self: center; margin-top: 10px; }
    .donut-circle { animation: fillDonut 1.2s cubic-bezier(0.1, 0.7, 0.1, 1) forwards; }
    .donut-text { font-size: 18px; font-weight: 700; fill: #10B981; transform: rotate(90deg) translate(0, -6px); transform-origin: 50px 50px; text-anchor: middle; animation: fadeText 1.5s ease-in forwards; opacity: 0; }
</style>

<div class='aio-container'>
    
    <!-- HEADER -->
    <div class='aio-header'>
        <div class='aio-title'>Total Movement (MTD)</div>
        <div class='aio-badge'>Achievement " & _PctText & "</div>
    </div>

    <!-- BODY -->
    <div class='aio-body'>
        
        <!-- LEFT: CHART AREA -->
        <div class='aio-chart-area'>
            <div class='aio-legend'>
                <div><span class='leg-box' style='background:#10B981;'></span>Daily Act (Right Axis)</div>
                <div><span class='leg-box' style='background:#D1D5DB;'></span>Daily Plan</div>
                <div><span class='leg-line' style='background:#3B82F6;'><style>.leg-line[style*='3B82F6']::after{background:#3B82F6;}</style></span>Cumm Actual (Left Axis)</div>
                <div><span class='leg-line' style='border-top: 2px dashed #EF4444; background:transparent;'><style>.leg-line[style*='dashed']::after{background:#EF4444; top:-4px;}</style></span>Cumm Plan</div>
            </div>
            
            <!-- Struktur Layout: Y-Kiri | Area Slider Scroll | Y-Kanan -->
            <div class='chart-layout'>
                
                <!-- Skala Y Kiri (Fixed) -->
                <div class='y-axis-left'>
                    <span>" & FORMAT(_MaxY_Scale, "#,##0") & "</span>
                    <span>" & FORMAT(_MaxY_Scale * 4/5, "#,##0") & "</span>
                    <span>" & FORMAT(_MaxY_Scale * 3/5, "#,##0") & "</span>
                    <span>" & FORMAT(_MaxY_Scale * 2/5, "#,##0") & "</span>
                    <span>" & FORMAT(_MaxY_Scale * 1/5, "#,##0") & "</span>
                    <span>0</span>
                </div>
                
                <!-- Area Tengah (Scroll Horizontal/Slider) -->
                <div class='scroll-area'>
                    <svg class='chart-svg-layer' width='" & _ChartWidth & "px' height='" & _SvgHeight & "px'>
                        
                        <defs>
                            <clipPath id='lineWipe2'>
                                <rect x='0' y='0' width='0' height='100%'>
                                    <animate attributeName='width' from='0' to='100%' dur='1.2s' fill='freeze' />
                                </rect>
                            </clipPath>
                        </defs>

                        <!-- Grid Lines -->
                        <line x1='0' y1='0'   x2='100%' y2='0'   stroke='#F3F4F6' stroke-width='1'/>
                        <line x1='0' y1='30'  x2='100%' y2='30'  stroke='#F3F4F6' stroke-width='1'/>
                        <line x1='0' y1='60'  x2='100%' y2='60'  stroke='#F3F4F6' stroke-width='1'/>
                        <line x1='0' y1='90'  x2='100%' y2='90'  stroke='#F3F4F6' stroke-width='1'/>
                        <line x1='0' y1='120' x2='100%' y2='120' stroke='#F3F4F6' stroke-width='1'/>
                        <line x1='0' y1='150' x2='100%' y2='150' stroke='#D1D5DB' stroke-width='2'/>
                        
                        <!-- Batang Data & Label Tanggal -->
                        " & _BarChartsHTML & "

                        <!-- Garis Data Kumulatif -->
                        <g clip-path='url(#lineWipe2)'>
                            <polyline class='line-plan' points='" & _PlanLinePoints & "' fill='none' stroke='#EF4444' stroke-width='2.5' stroke-dasharray='6,4' stroke-linejoin='round'>
                                <title>Cumulative Plan (MTD)</title>
                            </polyline>
                            <polyline class='line-act' points='" & _ActualLinePoints & "' fill='none' stroke='#3B82F6' stroke-width='2.5' stroke-linejoin='round'>
                                <title>Cumulative Actual (MTD)</title>
                            </polyline>
                        </g>
                    </svg>
                </div>

                <!-- Skala Y Kanan (Fixed) -->
                <div class='y-axis-right'>
                    <span>" & FORMAT(_MaxBar_Scale, "#,##0") & "</span>
                    <span>" & FORMAT(_MaxBar_Scale * 0.5, "#,##0") & "</span>
                    <span>0 kt/d</span>
                </div>

            </div>
        </div>

        <!-- RIGHT: SIDE PANEL (Putih) -->
        <div class='aio-side-panel'>
            <div class='ach-label'>MTD Plan</div>
            <div class='ach-val'>" & FORMAT(_MTDPlan, "#,##0") & " kt</div>
            
            <div class='ach-label'>MTD Actual</div>
            <div class='ach-val'>" & FORMAT(_MTDActual, "#,##0") & " kt</div>
            
            <!-- DONUT CHART (Lingkaran Putih) -->
            <svg class='donut-svg' viewBox='0 0 100 100'>
                <circle cx='50' cy='50' r='40' fill='#FFFFFF' stroke='#E5E7EB' stroke-width='8'></circle>
                <circle class='donut-circle' cx='50' cy='50' r='40' fill='none' stroke='#10B981' stroke-width='8' stroke-linecap='round'></circle>
                <text x='50' y='55' class='donut-text'>" & _PctText & "</text>
            </svg>
        </div>

    </div>
</div>"
