Table_PerformanceSummary_HTML =
// ==========================================
// 0. Ambil Tanggal Terpilih
// ==========================================
VAR _MinSelected  = MIN('mpx_daily_pondok_view'[report_date])
VAR _MaxSelected  = MAX('mpx_daily_pondok_view'[report_date])
VAR _MonthStart   = DATE(YEAR(_MaxSelected), MONTH(_MaxSelected), 1)
VAR _YearStart    = DATE(YEAR(_MaxSelected), 1, 1)

VAR _DailyLabel   = IF(
                        _MinSelected = _MaxSelected,
                        UPPER(FORMAT(_MaxSelected, "dd-MMM-yy")),
                        UPPER(FORMAT(_MinSelected, "dd-MMM-yy")) & " TO " & UPPER(FORMAT(_MaxSelected, "dd-MMM-yy"))
                    )
VAR _MonthLabel   = UPPER(FORMAT(_MonthStart, "dd-MMM-yy"))
VAR _YearLabel    = UPPER(FORMAT(_YearStart, "dd-MMM-yy"))

// ==========================================
// 1. HITUNG KOMPONEN DASAR (semua baris memakai unit "ton")
// ==========================================
// --- ORE MINED ---
VAR _Ore_D_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Ore_D_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Ore_M_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Ore_M_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Ore_Y_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Ore_Y_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"cil_ore_stockpile", "hl_ore_stockpile", "hl_ore_rom"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)

// --- WASTE MINED ---
VAR _Wst_D_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Wst_D_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Wst_M_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Wst_M_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Wst_Y_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Wst_Y_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"}, 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)

// --- OUT-PIT MOVEMENT ---
// PERBAIKAN: tambah filter unit = "ton". Versi lama "bebas unit", sehingga baris ton dan bcm ikut dijumlahkan
// (mis. 55,018 padahal yang benar 36,616 t, sama dengan kartu Total Out-Pit Movement), dan Total Mining Movement ikut salah.
VAR _Out_D_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Out_D_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MinSelected, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Out_M_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Out_M_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _MonthStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Out_Y_Act = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[actual]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)
VAR _Out_Y_Plan = COALESCE(CALCULATE(SUM('mpx_daily_pondok_view'[lomp]), 'mpx_daily_pondok_view'[leaf_key] = "total_outpit_movement", 'mpx_daily_pondok_view'[unit] = "ton", REMOVEFILTERS('mpx_daily_pondok_view'[report_date]), 'mpx_daily_pondok_view'[report_date] >= _YearStart, 'mpx_daily_pondok_view'[report_date] <= _MaxSelected), 0)


// ==========================================
// 2. GABUNGKAN DATA KE TABEL DENGAN PENJUMLAHAN PASTI
// ==========================================
VAR _Data =
    UNION(
        // Baris 1: Ore Mined
        ROW("ID", 1, "Desc", "Total Ore Mined (t)", "D_Act", _Ore_D_Act, "D_Plan", _Ore_D_Plan, "M_Act", _Ore_M_Act, "M_Plan", _Ore_M_Plan, "Y_Act", _Ore_Y_Act, "Y_Plan", _Ore_Y_Plan),

        // Baris 2: Waste Mined
        ROW("ID", 2, "Desc", "Total Waste Mined (t)", "D_Act", _Wst_D_Act, "D_Plan", _Wst_D_Plan, "M_Act", _Wst_M_Act, "M_Plan", _Wst_M_Plan, "Y_Act", _Wst_Y_Act, "Y_Plan", _Wst_Y_Plan),

        // Baris 3: Total Mined (Murni = Ore + Waste)
        ROW("ID", 3, "Desc", "Total Mined (t)", "D_Act", _Ore_D_Act + _Wst_D_Act, "D_Plan", _Ore_D_Plan + _Wst_D_Plan, "M_Act", _Ore_M_Act + _Wst_M_Act, "M_Plan", _Ore_M_Plan + _Wst_M_Plan, "Y_Act", _Ore_Y_Act + _Wst_Y_Act, "Y_Plan", _Ore_Y_Plan + _Wst_Y_Plan),

        // Baris 4: Out-Pit Movement
        ROW("ID", 4, "Desc", "Total Out-Pit Movement (t)", "D_Act", _Out_D_Act, "D_Plan", _Out_D_Plan, "M_Act", _Out_M_Act, "M_Plan", _Out_M_Plan, "Y_Act", _Out_Y_Act, "Y_Plan", _Out_Y_Plan),

        // Baris 5: Total Mining Movement (Murni = Total Mined + Out-Pit)
        ROW("ID", 5, "Desc", "Total Mining Movement (t)", "D_Act", _Ore_D_Act + _Wst_D_Act + _Out_D_Act, "D_Plan", _Ore_D_Plan + _Wst_D_Plan + _Out_D_Plan, "M_Act", _Ore_M_Act + _Wst_M_Act + _Out_M_Act, "M_Plan", _Ore_M_Plan + _Wst_M_Plan + _Out_M_Plan, "Y_Act", _Ore_Y_Act + _Wst_Y_Act + _Out_Y_Act, "Y_Plan", _Ore_Y_Plan + _Wst_Y_Plan + _Out_Y_Plan)
    )

// ==========================================
// 3. LOGIKA RENDER BARIS & PROTEKSI % ERROR
// ==========================================
VAR _RowsHTML =
    CONCATENATEX(
        _Data,
        // PERBAIKAN: dibulatkan ke 6 desimal (bukan 2) hanya untuk membuang sisa desimal Power BI.
        // ROUND(..., 2) lalu FORMAT "#,##0" = pembulatan dua kali: 2,366,949.4997 -> 2,366,949.50 -> 2,366,950
        // (seharusnya 2,366,949).
        VAR _D_Act = ROUND([D_Act], 6)
        VAR _D_Plan = ROUND([D_Plan], 6)
        VAR _D_Var = _D_Act - _D_Plan
        VAR _D_Pct = IF(_D_Plan = 0, 0, DIVIDE(_D_Var, _D_Plan, 0))

        VAR _M_Act = ROUND([M_Act], 6)
        VAR _M_Plan = ROUND([M_Plan], 6)
        VAR _M_Var = _M_Act - _M_Plan
        VAR _M_Pct = IF(_M_Plan = 0, 0, DIVIDE(_M_Var, _M_Plan, 0))

        VAR _Y_Act = ROUND([Y_Act], 6)
        VAR _Y_Plan = ROUND([Y_Plan], 6)
        VAR _Y_Var = _Y_Act - _Y_Plan
        VAR _Y_Pct = IF(_Y_Plan = 0, 0, DIVIDE(_Y_Var, _Y_Plan, 0))

        VAR _ColorD = IF(_D_Var >= 0, "#16A34A", "#DC2626")
        VAR _ColorM = IF(_M_Var >= 0, "#16A34A", "#DC2626")
        VAR _ColorY = IF(_Y_Var >= 0, "#16A34A", "#DC2626")

        RETURN
        "<tr>
            <td class='col-desc'>" & [Desc] & "</td>

            <!-- DAILY -->
            <td>" & FORMAT(_D_Act, "#,##0") & "</td>
            <td>" & FORMAT(_D_Plan, "#,##0") & "</td>
            <td style='color:" & _ColorD & "; font-weight:600;'>" & FORMAT(_D_Var, "+#,##0;-#,##0;0") & "</td>
            <td style='color:" & _ColorD & "; font-weight:600;'>" & FORMAT(_D_Pct, "+0%;-0%;0%") & "</td>

            <!-- MTD -->
            <td>" & FORMAT(_M_Act, "#,##0") & "</td>
            <td>" & FORMAT(_M_Plan, "#,##0") & "</td>
            <td style='color:" & _ColorM & "; font-weight:600;'>" & FORMAT(_M_Var, "+#,##0;-#,##0;0") & "</td>
            <td style='color:" & _ColorM & "; font-weight:600;'>" & FORMAT(_M_Pct, "+0%;-0%;0%") & "</td>

            <!-- YTD -->
            <td>" & FORMAT(_Y_Act, "#,##0") & "</td>
            <td>" & FORMAT(_Y_Plan, "#,##0") & "</td>
            <td style='color:" & _ColorY & "; font-weight:600;'>" & FORMAT(_Y_Var, "+#,##0;-#,##0;0") & "</td>
            <td style='color:" & _ColorY & "; font-weight:600;'>" & FORMAT(_Y_Pct, "+0%;-0%;0%") & "</td>
        </tr>",
        "",
        [ID], ASC
    )

// ==========================================
// 4. RENDER HTML CSS
// ==========================================
RETURN
"<style>
    .ps-container { font-family: 'Segoe UI', sans-serif; background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 8px; width: 100%; box-shadow: 0px 1px 3px rgba(0,0,0,0.05); overflow: hidden; }
    .ps-header { padding: 16px 20px; font-size: 16px; font-weight: 600; color: #1F2937; border-bottom: 1px solid #E5E7EB; }
    .ps-table { width: 100%; border-collapse: collapse; text-align: right; font-size: 12px; }

    .ps-table th { border: 1px solid #E5E7EB; padding: 12px 10px; font-weight: 600; color: #4B5563; text-transform: uppercase; }
    .ps-table .th-group { background-color: #FAFAFA; text-align: center; }
    .ps-table .th-sub { background-color: #FFFFFF; font-size: 11px; }

    .ps-table td { border: 1px solid #E5E7EB; padding: 14px 10px; color: #374151; font-weight: 500; }
    .ps-table .col-desc { text-align: left; font-weight: 600; color: #1F2937; background-color: #FAFAFA; padding-left: 16px; width: 22%; }

    .ps-table tr:hover td { background-color: #F9FAFB; }
</style>

<div class='ps-container'>
    <div class='ps-header'>Performance Summary</div>
    <table class='ps-table'>
        <thead>
            <tr>
                <th rowspan='2' class='th-group' style='text-align: left; padding-left: 16px;'>DESCRIPTION</th>
                <th colspan='4' class='th-group'>DAILY (" & _DailyLabel & ")</th>
                <th colspan='4' class='th-group'>MTD (" & _MonthLabel & " - " & UPPER(FORMAT(_MaxSelected, "dd-MMM-yy")) & ")</th>
                <th colspan='4' class='th-group'>YTD (" & _YearLabel & " - " & UPPER(FORMAT(_MaxSelected, "dd-MMM-yy")) & ")</th>
            </tr>
            <tr>
                <th class='th-sub'>ACTUAL</th><th class='th-sub'>PLAN</th><th class='th-sub'>VAR</th><th class='th-sub'>% VAR</th>
                <th class='th-sub'>ACTUAL</th><th class='th-sub'>PLAN</th><th class='th-sub'>VAR</th><th class='th-sub'>% VAR</th>
                <th class='th-sub'>ACTUAL</th><th class='th-sub'>PLAN</th><th class='th-sub'>VAR</th><th class='th-sub'>% VAR</th>
            </tr>
        </thead>
        <tbody>
            " & _RowsHTML & "
        </tbody>
    </table>
</div>"
