Card_TotalWasteMined_HTML =
VAR _Actual =
    CALCULATE(
        SUM('mpx_daily_pondok_view'[Actual]),
        'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"},
        'mpx_daily_pondok_view'[Unit] = "Ton"
    )

VAR _Plan =
    CALCULATE(
        SUM('mpx_daily_pondok_view'[lomp]),
        'mpx_daily_pondok_view'[leaf_key] IN {"waste", "mw"},
        'mpx_daily_pondok_view'[Unit] = "Ton"
    )

VAR _Var = DIVIDE(_Actual - _Plan, _Plan, 0)

VAR _ActualText = FORMAT(COALESCE(_Actual, 0), "#,##0")
VAR _PlanText = FORMAT(COALESCE(_Plan, 0), "#,##0")
VAR _VarText = FORMAT(_Var, "+0%;-0%;0%")

VAR _BadgeBg = IF(_Var >= 0, "#DCFCE7", "#FEE2E2")
VAR _BadgeColor = IF(_Var >= 0, "#16A34A", "#DC2626")

VAR _IconBg = "#FAF5FF"
VAR _IconBorder = "#E9D5FF"
VAR _IconColor = "#A855F7"
// PERBAIKAN: nilainya ton (filter Unit = "Ton"), jadi satuannya "t", bukan "bcm" (warna disamakan dengan kartu lain)
VAR _UnitColor = "#2563EB"
VAR _Unit = "t"
VAR _Title = "Total Waste Mined (MTD)"

VAR _SvgIcon = "<svg width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='" & _IconColor & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 18l6-11 5 6 7-9'/></svg>"

RETURN
"<style>
    .kpi-card { font-family: 'Segoe UI', sans-serif; background-color: #FFFFFF; border-radius: 12px; padding: 20px; border: 1px solid #EAEAEA; box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.03); display: flex; align-items: center; height: 100%; box-sizing: border-box; transition: transform 0.2s ease; }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: 0px 6px 14px rgba(0, 0, 0, 0.06); }
    .kpi-icon { width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-right: 18px; flex-shrink: 0; background-color: " & _IconBg & "; border: 1px solid " & _IconBorder & "; }
    .kpi-content { flex-grow: 1; display: flex; flex-direction: column; }
    .kpi-title { font-size: 13px; color: #111827; margin-bottom: 4px; font-weight: 500; }
    .kpi-value-row { display: flex; align-items: baseline; margin-bottom: 8px; }
    .kpi-value { font-size: 24px; font-weight: 700; color: #030712; line-height: 1; }
    .kpi-unit { font-size: 18px; font-weight: 600; color: " & _UnitColor & "; margin-left: 6px; }
    .kpi-footer { display: flex; justify-content: space-between; align-items: center; width: 100%; }
    .kpi-plan { font-size: 12px; color: #6B7280; }
    .kpi-badge { padding: 3px 6px; border-radius: 4px; font-size: 11px; font-weight: 600; background-color: " & _BadgeBg & "; color: " & _BadgeColor & "; }
</style>
<div class='kpi-card'>
    <div class='kpi-icon'>" & _SvgIcon & "</div>
    <div class='kpi-content'>
        <div class='kpi-title'>" & _Title & "</div>
        <div class='kpi-value-row'><div class='kpi-value'>" & _ActualText & "</div><div class='kpi-unit'>" & _Unit & "</div></div>
        <div class='kpi-footer'><div class='kpi-plan'>vs Plan " & _PlanText & "</div><div class='kpi-badge'>" & _VarText & "</div></div>
    </div>
</div>"
