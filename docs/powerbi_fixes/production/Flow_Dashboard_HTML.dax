Flow_Dashboard_HTML = 
// 1. Variabel Nilai Dinamis dari Tabel stockpile_summary_view
VAR _InputBCM = SUM('mpx_stockpile_summary_view'[tonnes_addition])
VAR _OutputBCM = SUM('mpx_stockpile_summary_view'[tonnes_depletion])

// Asumsi nilai Tonnes 
VAR _InputTon = _InputBCM * 2.19 
VAR _OutputTon = _OutputBCM * 1.93 

// Filter Breakdown
VAR _CrushingBCM = CALCULATE(
    SUM('mpx_stockpile_summary_view'[tonnes_addition]),
    CONTAINSSTRING('mpx_stockpile_summary_view'[dump_location], "Crusher")
)
VAR _ScreeningBCM = CALCULATE(
    SUM('mpx_stockpile_summary_view'[tonnes_addition]),
    CONTAINSSTRING('mpx_stockpile_summary_view'[dump_location], "Screening")
)
VAR _StockpileBCM = CALCULATE(
    SUM('mpx_stockpile_summary_view'[tonnes_addition]),
    CONTAINSSTRING('mpx_stockpile_summary_view'[dump_location], "Stockpile")
)

// Kalkulasi Persentase Dinamis
VAR _FlowPctValue = DIVIDE(_OutputBCM, _InputBCM, 0)
VAR _FlowPctText = FORMAT(_FlowPctValue, "0.00%")

// Persentase untuk render SVG Donut 
VAR _OutputPct = MIN(ROUND(_FlowPctValue * 100, 0), 100) 
VAR _OutputText = ROUND(_FlowPctValue * 100, 0) & "%" 

// 2. Format Teks
VAR _Fmt_InBCM = FORMAT(_InputBCM, "#,##0.00") & " BCM"
VAR _Fmt_InTon = FORMAT(_InputTon, "#,##0.00") & " Tonnes"
VAR _Fmt_OutBCM = FORMAT(_OutputBCM, "#,##0.00") & " BCM"
VAR _Fmt_OutTon = FORMAT(_OutputTon, "#,##0.00") & " Tonnes"
VAR _Fmt_Crushing = FORMAT(COALESCE(_CrushingBCM, 0), "#,##0.00") & " BCM"
VAR _Fmt_Screening = FORMAT(COALESCE(_ScreeningBCM, 0), "#,##0.00") & " BCM"
VAR _Fmt_Stockpile = FORMAT(COALESCE(_StockpileBCM, 0), "#,##0.00") & " BCM"

// PERBAIKAN: lebar bar di bawah tahapan = porsi Crushing / Screening / Stockpile dari total ketiganya.
// Versi lama memakai lebar tetap (biru 20%, oranye 80%) yang tidak berhubungan dengan data.
VAR _StageTotal = COALESCE(_CrushingBCM, 0) + COALESCE(_ScreeningBCM, 0) + COALESCE(_StockpileBCM, 0)
VAR _BarCrushing = FORMAT(DIVIDE(COALESCE(_CrushingBCM, 0), _StageTotal, 0) * 100, "0.00", "en-US")
VAR _BarScreening = FORMAT(DIVIDE(COALESCE(_ScreeningBCM, 0), _StageTotal, 0) * 100, "0.00", "en-US")
VAR _BarStockpile = FORMAT(DIVIDE(COALESCE(_StockpileBCM, 0), _StageTotal, 0) * 100, "0.00", "en-US")

// 3. SVG Donut Charts
VAR _SvgInput = "<svg viewBox='0 0 36 36' class='donut'><path class='donut-ring' d='M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831'/><path class='donut-segment input-segment' stroke-dasharray='100, 100' d='M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831'/><text x='18' y='18' dominant-baseline='central' class='donut-text input-text'>100%</text></svg>"

VAR _SvgOutput = "<svg viewBox='0 0 36 36' class='donut'><path class='donut-ring' d='M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831'/><path class='donut-segment output-segment' stroke-dasharray='" & _OutputPct & ", 100' d='M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831'/><text x='18' y='18' dominant-baseline='central' class='donut-text output-text'>" & _OutputText & "</text></svg>"

RETURN
"<style>
    /* Keyframes Animasi */
    @keyframes fadeInUp {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes drawDonut {
        0% { stroke-dasharray: 0, 100; }
    }
    @keyframes expandBar {
        0% { width: 0%; }
    }

    /* Container Induk - Ukuran Dinamis 100% */
    .flow-container { 
        font-family: 'Segoe UI', sans-serif; background: #fff; padding: 3% 4%; 
        border: 1px solid #E5E7EB; border-radius: 12px; 
        display: flex; justify-content: space-between; align-items: flex-start;
        width: 100%; height: 100%; box-sizing: border-box;
        animation: fadeInUp 0.7s ease-out forwards;
        overflow: hidden;
    }
    
    /* Kolom Flexbox - Agar melar otomatis */
    .col { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 25%; max-width: 30%; }
    .col-mid { flex: 1.2; display: flex; flex-direction: column; gap: 12px; min-width: 30%; padding-top: 10px; }
    
    /* Kotak Input/Output + Hover Effect */
    .box-header { 
        width: 100%; text-align: center; padding: 10% 5%; border-radius: 10px; 
        margin-bottom: 20px; box-sizing: border-box; cursor: default;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }
    .box-header:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
    
    .bg-blue { background-color: #DBEAFE; border: 1px solid #BFDBFE; }
    .bg-green { background-color: #DCFCE7; border: 1px solid #BBF7D0; }
    
    .box-title { font-size: clamp(10px, 1.2vw, 12px); color: #4B5563; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .box-val { font-size: clamp(14px, 1.8vw, 20px); font-weight: 800; color: #111827; margin: 6px 0; }
    .box-sub { font-size: clamp(9px, 1vw, 11px); color: #6B7280; line-height: 1.4; }
    
    /* List Proses (Tengah) + Hover Effect */
    .process-item { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 10px 16px; border: 1px solid #E5E7EB; border-radius: 8px; 
        font-size: clamp(11px, 1.2vw, 13px); font-weight: 500; color: #374151;
        transition: all 0.3s ease; cursor: default; background: #fff;
    }
    .process-item:hover {
        transform: scale(1.03);
        background-color: #F9FAFB;
        border-color: #D1D5DB;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    
    .progress-bar-container { width: 100%; height: 6px; background: #E5E7EB; border-radius: 3px; margin-top: 8px; display: flex; overflow: hidden; }
    .bar-blue { background: #3B82F6; animation: expandBar 1.5s ease-out; }
    .bar-green { background: #10B981; animation: expandBar 1.5s ease-out; }
    .bar-orange { background: #F97316; animation: expandBar 1.5s ease-out; }
    
    /* Panah */
    .arrow { display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 60px; color: #9CA3AF; font-size: clamp(16px, 2vw, 22px); font-weight: 300; width: 8%; }
    .arrow-pct { font-size: clamp(9px, 1vw, 11px); font-weight: 700; color: #10B981; margin-top: 4px; }
    
    /* Donut Chart SVG + Hover Effect */
    .donut { 
        width: 100%; max-width: 110px; height: auto; aspect-ratio: 1/1; 
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .donut:hover { transform: scale(1.15) rotate(5deg); }
    
    .donut-ring { fill: transparent; stroke: #F3F4F6; stroke-width: 4; }
    .donut-segment { fill: transparent; stroke-width: 4; stroke-linecap: round; animation: drawDonut 1.5s cubic-bezier(0.1, 0.7, 0.1, 1) forwards; }
    .input-segment { stroke: #3B82F6; }
    .output-segment { stroke: #10B981; }
    
    .donut-text { font-family: 'Segoe UI', sans-serif; font-size: 8px; font-weight: bold; text-anchor: middle; animation: fadeInUp 1s ease-out; }
    .input-text { fill: #3B82F6; }
    .output-text { fill: #10B981; }
</style>

<div class='flow-container'>
    <!-- Kiri: Input -->
    <div class='col'>
        <div class='box-header bg-blue'>
            <div class='box-title'>Input</div>
            <div class='box-val'>" & _Fmt_InBCM & "</div>
            <div class='box-sub'>" & _Fmt_InTon & "<br>1 BCM = 2.19 Ton</div>
        </div>
        " & _SvgInput & "
    </div>

    <div class='arrow'>→</div>

    <!-- Tengah: Proses -->
    <div class='col-mid'>
        <div class='process-item'><span>🔨 Crushing</span><span>" & _Fmt_Crushing & "</span></div>
        <div class='process-item'><span>⚄ Screening</span><span>" & _Fmt_Screening & "</span></div>
        <div class='process-item'><span>⛰️ Stockpile</span><span>" & _Fmt_Stockpile & "</span></div>
        <div class='progress-bar-container'>
            <div class='bar-blue' title='Crushing' style='width: " & _BarCrushing & "%'></div><div class='bar-green' title='Screening' style='width: " & _BarScreening & "%'></div><div class='bar-orange' title='Stockpile' style='width: " & _BarStockpile & "%'></div>
        </div>
    </div>

    <div class='arrow'>→<div class='arrow-pct'>" & _FlowPctText & "</div></div>

    <!-- Kanan: Output -->
    <div class='col'>
        <div class='box-header bg-green'>
            <div class='box-title'>Output</div>
            <div class='box-val'>" & _Fmt_OutBCM & "</div>
            <div class='box-sub'>" & _Fmt_OutTon & "<br>1 BCM = 1.93 Ton</div>
        </div>
        " & _SvgOutput & "
    </div>
</div>"
