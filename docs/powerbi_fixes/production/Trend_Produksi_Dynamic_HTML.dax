Trend_Produksi_Dynamic_HTML =
-- ============================================================
-- 1. BASE DATA (DAILY, WEEKLY, MTD)
--
-- PERBAIKAN: data diambil per tanggal yang ADA DI FILTER (slicer tanggal dan filter lain ikut berlaku).
-- Versi lama membuat kalender sendiri (tanggal pertama data s/d TODAY) yang tidak terhubung ke tabel:
--   - Daily  : setiap batang berisi total seluruh filter (angkanya sama semua), sampai tanggal hari ini
--   - Weekly : FILTER(ALL(ritase_date)) membuang filter tanggal, jadi selalu menampilkan seluruh data
--   - MTD    : sama dengan Weekly
-- ============================================================
VAR _ByDate =
    ADDCOLUMNS(
        SUMMARIZE('mpx_stockpile_summary_view', 'mpx_stockpile_summary_view'[ritase_date]),
        "@In", COALESCE(CALCULATE(SUM('mpx_stockpile_summary_view'[tonnes_addition])), 0),
        "@Out", COALESCE(CALCULATE(SUM('mpx_stockpile_summary_view'[tonnes_depletion])), 0)
    )

-- A. DAILY AGGREGATION
VAR _DailyTable =
    SELECTCOLUMNS(
        _ByDate,
        "@SortDate", 'mpx_stockpile_summary_view'[ritase_date],
        "@In", [@In],
        "@Out", [@Out]
    )

-- B. WEEKLY AGGREGATION (Senin)
VAR _WeeklyTable =
    GROUPBY(
        ADDCOLUMNS(_DailyTable, "@WeekStart", [@SortDate] - WEEKDAY([@SortDate], 2) + 1),
        [@WeekStart],
        "@In", SUMX(CURRENTGROUP(), [@In]),
        "@Out", SUMX(CURRENTGROUP(), [@Out])
    )

-- C. MTD AGGREGATION (Bulanan)
VAR _MTDTable =
    GROUPBY(
        ADDCOLUMNS(_DailyTable, "@MonthStart", DATE(YEAR([@SortDate]), MONTH([@SortDate]), 1)),
        [@MonthStart],
        "@In", SUMX(CURRENTGROUP(), [@In]),
        "@Out", SUMX(CURRENTGROUP(), [@Out])
    )

-- ============================================================
-- 2. CONVERT TO JSON
-- ============================================================
VAR _DailyJson =
    "[" & CONCATENATEX(_DailyTable, "{""lbl"":""" & FORMAT([@SortDate], "dd MMM") & """,""in"":" & FORMAT([@In], "0.##", "en-US") & ",""out"":" & FORMAT([@Out], "0.##", "en-US") & ",""sort"":" & INT([@SortDate]) & "}", ",", [@SortDate], DESC) & "]"

VAR _WeeklyJson =
    "[" & CONCATENATEX(_WeeklyTable, "{""lbl"":""" & FORMAT([@WeekStart], "dd MMM yyyy") & """,""in"":" & FORMAT([@In], "0.##", "en-US") & ",""out"":" & FORMAT([@Out], "0.##", "en-US") & ",""sort"":" & INT([@WeekStart]) & "}", ",", [@WeekStart], DESC) & "]"

VAR _MTDJson =
    "[" & CONCATENATEX(_MTDTable, "{""lbl"":""" & FORMAT([@MonthStart], "MMM yyyy") & """,""in"":" & FORMAT([@In], "0.##", "en-US") & ",""out"":" & FORMAT([@Out], "0.##", "en-US") & ",""sort"":" & INT([@MonthStart]) & "}", ",", [@MonthStart], DESC) & "]"

-- ============================================================
-- 3. HTML, CSS & JAVASCRIPT (hanya rumus net yang berubah, lihat PERBAIKAN)
-- ============================================================
RETURN
"<!DOCTYPE html>
<html>
<head>
<meta charset='UTF-8'>
<style>
    * { margin:0; padding:0; box-sizing:border-box; }
    html, body { width:100%; height:100%; background:transparent; overflow:hidden; font-family:'Segoe UI',sans-serif; }

    .dashboard-container { background:#fff; border:1px solid #E5E7EB; border-radius:12px; width:100%; height:100%; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 4px 15px rgba(15,23,42,0.05); }
    .header-bar { padding:12px 20px; border-bottom:1px solid #E5E7EB; display:flex; justify-content:space-between; align-items:center; background:#fff; }
    .title { font-size:15px; font-weight:600; color:#111827; }

    /* Navigation Buttons Layout Right */
    .btn-group { display:flex; border:1px solid #2563EB; border-radius:6px; overflow:hidden; background:#fff; margin-left:auto; }
    .btn { padding:4px 14px; font-size:12px; color:#2563EB; background:#fff; border:none; border-right:1px solid #2563EB; font-weight:600; cursor:pointer; transition:all 0.2s ease; }
    .btn:last-child { border-right:none; }
    .btn:hover { background:#EFF6FF; }
    .btn.active { background:#2563EB; color:#fff; }

    .legend-row { display:flex; justify-content:center; gap:20px; padding-top:10px; font-size:12px; color:#4B5563; font-weight:500; }
    .legend-item { display:flex; align-items:center; gap:6px; }

    .chart-layout { display:flex; flex-grow:1; overflow:hidden; margin-top:5px; }
    .y-axis { width:65px; flex-shrink:0; background:#fff; z-index:10; border-right:1px solid #F3F4F6; }
    .chart-scroll { flex-grow:1; overflow-x:auto; overflow-y:hidden; }

    .chart-scroll::-webkit-scrollbar { height:8px; }
    .chart-scroll::-webkit-scrollbar-track { background:#F8FAFC; border-radius:4px; }
    .chart-scroll::-webkit-scrollbar-thumb { background:#CBD5E1; border-radius:4px; }
    .chart-scroll::-webkit-scrollbar-thumb:hover { background:#94A3B8; }

    /* CSS Animations & Hover */
    @keyframes fadeSlideUp {
        0% { opacity:0; transform:translateY(15px); }
        100% { opacity:1; transform:translateY(0); }
    }

    .data-group { opacity:0; animation:fadeSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; cursor:crosshair; }
    .hover-bg { transition:fill 0.2s ease; }
    .data-group:hover .hover-bg { fill:rgba(243, 244, 246, 0.7); }
    .bar-text { transition:opacity 0.2s ease; }
    .data-group:hover .bar-text { opacity:0.15; }

    .bar-in, .bar-out { transition:all 0.2s ease; }
    .data-group:hover .bar-in { fill:#2563EB; stroke:#1D4ED8; stroke-width:1.5px; }
    .data-group:hover .bar-out { fill:#059669; stroke:#047857; stroke-width:1.5px; }

    .net-dot { transition:all 0.2s ease; }
    .data-group:hover .net-dot { stroke-width:4px; r:5.5px; }

    /* Tooltip Popup Floating Inside Top Area */
    .tooltip-box { opacity:0; visibility:hidden; transform:translateY(10px); transition:all 0.25s ease; pointer-events:none; }
    .data-group:hover .tooltip-box { opacity:1; visibility:visible; transform:translateY(0); }

    .main-line { stroke-dasharray:5000; stroke-dashoffset:5000; animation:drawLine 2s ease-out forwards; }
    @keyframes drawLine { to { stroke-dashoffset:0; } }
</style>
</head>
<body>

<div class='dashboard-container'>
    <div class='header-bar'>
        <div class='title' id='chart-title'>Trend Produksi (BCM) - Daily</div>
        <div class='btn-group'>
            <button class='btn active' id='btn-daily' onclick=""switchPage('daily')"">Daily</button>
            <button class='btn' id='btn-weekly' onclick=""switchPage('weekly')"">Weekly</button>
            <button class='btn' id='btn-mtd' onclick=""switchPage('mtd')"">MTD</button>
        </div>
    </div>

    <div class='legend-row'>
        <div class='legend-item'><div style='width:20px; height:10px; background:#3B82F6; border-radius:3px;'></div> Input</div>
        <div class='legend-item'><div style='width:20px; height:10px; background:#10B981; border-radius:3px;'></div> Output</div>
        <div class='legend-item'><svg width='24' height='10'><line x1='0' y1='5' x2='24' y2='5' stroke='#A855F7' stroke-width='2.5'/><circle cx='12' cy='5' r='3.5' fill='#fff' stroke='#A855F7' stroke-width='2.5'/></svg> Net Movement</div>
    </div>

    <div class='chart-layout'>
        <div class='y-axis' id='y-axis-container'></div>
        <div class='chart-scroll' id='chart-container'></div>
    </div>
</div>

<script>
    var db = {
        'daily': " & _DailyJson & ",
        'weekly': " & _WeeklyJson & ",
        'mtd': " & _MTDJson & "
    };

    var currentMode = 'daily';

    function fmt(n) {
        return Math.round(n).toLocaleString('en-US');
    }

    function switchPage(mode) {
        currentMode = mode;

        document.querySelectorAll('.btn').forEach(function(b){ b.classList.remove('active'); });
        document.getElementById('btn-' + mode).classList.add('active');

        var titles = { 'daily': 'Daily', 'weekly': 'Weekly', 'mtd': 'MTD' };
        document.getElementById('chart-title').textContent = 'Trend Produksi (BCM) - ' + titles[mode];

        render();
    }

    function render() {
        var data = db[currentMode];
        if (!data || data.length === 0) return;

        var maxVal = -Infinity, minVal = Infinity;
        data.forEach(function(d) {
            var net = d.out - d.in;  // PERBAIKAN: Output - Input, sama dengan kartu Net Movement
            maxVal = Math.max(maxVal, d.in, d.out, net);
            minVal = Math.min(minVal, d.in, d.out, net);
        });

        var minLimit = minVal > 0 ? 0 : minVal * 1.2;
        var maxLimit = maxVal <= 0 ? 100 : maxVal * 1.25;
        var range = maxLimit - minLimit;
        if (range === 0) range = 1;

        var svgHeight = 420;
        var marginTop = 65;
        var marginBottom = 40;
        var chartHeight = svgHeight - marginTop - marginBottom;
        var pointWidth = currentMode === 'daily' ? 95 : (currentMode === 'weekly' ? 115 : 130);
        var barWidth = 26;
        var rightPadding = 80;
        var svgWidth = Math.max(800, data.length * pointWidth + rightPadding);

        var yZero = marginTop + chartHeight - ((0 - minLimit) / range) * chartHeight;

        // 1. Render Sticky Y-Axis
        var ySvg = ""<svg viewBox='0 0 65 "" + svgHeight + ""' width='100%' height='100%' preserveAspectRatio='none'>"";
        ySvg += ""<text x='55' y='"" + (marginTop + 4) + ""' font-size='10' font-family='sans-serif' fill='#6B7280' font-weight='600' text-anchor='end'>"" + fmt(maxLimit) + ""</text>"";
        ySvg += ""<text x='55' y='"" + (marginTop + chartHeight*0.25 + 4) + ""' font-size='10' font-family='sans-serif' fill='#9CA3AF' text-anchor='end'>"" + fmt(maxLimit - range*0.25) + ""</text>"";
        ySvg += ""<text x='55' y='"" + (marginTop + chartHeight*0.5 + 4) + ""' font-size='10' font-family='sans-serif' fill='#9CA3AF' text-anchor='end'>"" + fmt(maxLimit - range*0.5) + ""</text>"";
        ySvg += ""<text x='55' y='"" + (marginTop + chartHeight*0.75 + 4) + ""' font-size='10' font-family='sans-serif' fill='#9CA3AF' text-anchor='end'>"" + fmt(maxLimit - range*0.75) + ""</text>"";
        ySvg += ""<text x='55' y='"" + (marginTop + chartHeight + 4) + ""' font-size='10' font-family='sans-serif' fill='#6B7280' font-weight='600' text-anchor='end'>"" + fmt(minLimit) + ""</text>"";
        ySvg += ""</svg>"";
        document.getElementById('y-axis-container').innerHTML = ySvg;

        // 2. Render Main Scrollable SVG
        var grid = ""<line x1='0' y1='"" + yZero + ""' x2='"" + svgWidth + ""' y2='"" + yZero + ""' stroke='#4B5563' stroke-width='1.5' />"";
        grid += ""<line x1='0' y1='"" + marginTop + ""' x2='"" + svgWidth + ""' y2='"" + marginTop + ""' stroke='#F3F4F6' stroke-width='1' />"";
        grid += ""<line x1='0' y1='"" + (marginTop + chartHeight*0.25) + ""' x2='"" + svgWidth + ""' y2='"" + (marginTop + chartHeight*0.25) + ""' stroke='#E5E7EB' stroke-width='1' stroke-dasharray='4' />"";
        grid += ""<line x1='0' y1='"" + (marginTop + chartHeight*0.5) + ""' x2='"" + svgWidth + ""' y2='"" + (marginTop + chartHeight*0.5) + ""' stroke='#E5E7EB' stroke-width='1' stroke-dasharray='4' />"";
        grid += ""<line x1='0' y1='"" + (marginTop + chartHeight*0.75) + ""' x2='"" + svgWidth + ""' y2='"" + (marginTop + chartHeight*0.75) + ""' stroke='#E5E7EB' stroke-width='1' stroke-dasharray='4' />"";
        grid += ""<line x1='0' y1='"" + (marginTop + chartHeight) + ""' x2='"" + svgWidth + ""' y2='"" + (marginTop + chartHeight) + ""' stroke='#E5E7EB' stroke-width='1' />"";

        var elements = '';
        var linePts = [];

        data.forEach(function(d, i) {
            var cX = 25 + i * pointWidth + (pointWidth / 2);
            var cX_In = cX - barWidth - 1;
            var cX_Out = cX + 1;

            var yInRaw = marginTop + chartHeight - ((d.in - minLimit) / range) * chartHeight;
            var cY_In = Math.min(yZero, yInRaw);
            var cH_In = Math.max(0, Math.abs(yZero - yInRaw));

            var yOutRaw = marginTop + chartHeight - ((d.out - minLimit) / range) * chartHeight;
            var cY_Out = Math.min(yZero, yOutRaw);
            var cH_Out = Math.max(0, Math.abs(yZero - yOutRaw));

            var net = d.out - d.in;  // PERBAIKAN: Output - Input, sama dengan kartu Net Movement
            var cY_Net = marginTop + chartHeight - ((net - minLimit) / range) * chartHeight;

            linePts.push(cX + ',' + cY_Net);

            var delay = (i * 0.03).toFixed(2);
            var netTxt = fmt(net);
            var inTxt = fmt(d.in);
            var outTxt = fmt(d.out);

            // Kalkulasi Posisi Teks & Badge Background
            var inY = d.in < 0 ? cY_In + cH_In + 12 : cY_In - 6;
            var inBadgeW = Math.max(42, inTxt.length * 6.5 + 8);
            var inBadgeX = (cX_In + barWidth/2) - (inBadgeW / 2);

            var outY = d.out < 0 ? cY_Out + cH_Out + 12 : cY_Out - 6;
            var outBadgeW = Math.max(42, outTxt.length * 6.5 + 8);
            var outBadgeX = (cX_Out + barWidth/2) - (outBadgeW / 2);

            var netY = net < 0 ? cY_Net + 18 : cY_Net - 12;
            var netBadgeW = Math.max(48, netTxt.length * 7 + 12);
            var netBadgeX = cX - (netBadgeW / 2);

            elements += ""<g class='data-group' style='animation-delay: "" + delay + ""s;'>"";
            elements += ""<rect class='hover-bg' x='"" + (cX - pointWidth/2) + ""' y='0' width='"" + pointWidth + ""' height='"" + svgHeight + ""' fill='transparent' />"";
            elements += ""<rect class='bar-in' x='"" + cX_In + ""' y='"" + cY_In + ""' width='"" + barWidth + ""' height='"" + cH_In + ""' fill='#3B82F6' rx='3' />"";
            elements += ""<rect class='bar-out' x='"" + cX_Out + ""' y='"" + cY_Out + ""' width='"" + barWidth + ""' height='"" + cH_Out + ""' fill='#10B981' rx='3' />"";

            // 🚀 BACKGROUND BADGE DIBELAKANG ANGKA INPUT (BAR BIRU)
            elements += ""<rect class='bar-text' x='"" + inBadgeX + ""' y='"" + (inY - 10) + ""' width='"" + inBadgeW + ""' height='13' fill='rgba(255, 255, 255, 0.88)' rx='3' stroke='rgba(59, 130, 246, 0.2)' stroke-width='0.6' />"";
            elements += ""<text class='bar-text' x='"" + (cX_In + barWidth/2) + ""' y='"" + inY + ""' font-size='9.5' font-family='sans-serif' fill='#4B5563' font-weight='600' text-anchor='middle'>"" + inTxt + ""</text>"";

            // 🚀 BACKGROUND BADGE DIBELAKANG ANGKA OUTPUT (BAR HIJAU)
            elements += ""<rect class='bar-text' x='"" + outBadgeX + ""' y='"" + (outY - 10) + ""' width='"" + outBadgeW + ""' height='13' fill='rgba(255, 255, 255, 0.88)' rx='3' stroke='rgba(16, 185, 129, 0.2)' stroke-width='0.6' />"";
            elements += ""<text class='bar-text' x='"" + (cX_Out + barWidth/2) + ""' y='"" + outY + ""' font-size='9.5' font-family='sans-serif' fill='#4B5563' font-weight='600' text-anchor='middle'>"" + outTxt + ""</text>"";

            // 🚀 BACKGROUND BADGE DIBELAKANG ANGKA NET MOVEMENT (GARIS UNGU)
            elements += ""<rect class='bar-text' x='"" + netBadgeX + ""' y='"" + (netY - 11) + ""' width='"" + netBadgeW + ""' height='15' fill='rgba(255, 255, 255, 0.92)' rx='4' stroke='rgba(168, 85, 247, 0.25)' stroke-width='0.8' />"";
            elements += ""<text class='bar-text' x='"" + cX + ""' y='"" + netY + ""' font-size='10.5' font-weight='700' font-family='sans-serif' fill='#A855F7' text-anchor='middle'>"" + netTxt + ""</text>"";

            elements += ""<circle class='net-dot' cx='"" + cX + ""' cy='"" + cY_Net + ""' r='4.5' fill='#fff' stroke='#A855F7' stroke-width='2.5' />"";
            elements += ""<text x='"" + cX + ""' y='"" + (svgHeight - 15) + ""' font-size='10' font-family='sans-serif' fill='#4B5563' font-weight='600' text-anchor='middle'>"" + d.lbl + ""</text>"";

            // Tooltip Floating Center Top
            elements += ""<g class='tooltip-box'>"";
            elements += ""<rect x='"" + (cX - 50) + ""' y='5' width='100' height='52' fill='#1F2937' opacity='0.95' rx='6' />"";
            elements += ""<text x='"" + cX + ""' y='18' fill='#D1D5DB' font-size='9.5' font-family='sans-serif' text-anchor='middle'>Input : <tspan fill='#60A5FA' font-weight='bold'>"" + inTxt + ""</tspan></text>"";
            elements += ""<text x='"" + cX + ""' y='33' fill='#D1D5DB' font-size='9.5' font-family='sans-serif' text-anchor='middle'>Output: <tspan fill='#34D399' font-weight='bold'>"" + outTxt + ""</tspan></text>"";
            elements += ""<text x='"" + cX + ""' y='48' fill='#D1D5DB' font-size='9.5' font-family='sans-serif' text-anchor='middle'>Net : <tspan fill='#C084FC' font-weight='bold'>"" + netTxt + ""</tspan></text>"";
            elements += ""</g>"";

            elements += ""</g>"";
        });

        var polyline = ""<polyline class='main-line' points='"" + linePts.join(' ') + ""' fill='none' stroke='#A855F7' stroke-width='3' />"";

        var mainSvg = ""<svg viewBox='0 0 "" + svgWidth + "" "" + svgHeight + ""' style='width:"" + svgWidth + ""px; min-width:"" + svgWidth + ""px; height:100%;' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>"";
        mainSvg += grid + polyline + elements + ""</svg>"";

        document.getElementById('chart-container').innerHTML = mainSvg;
    }

    render();
</script>

</body>
</html>"
