# Salin file ini menjadi .env lalu isi nilainya. File .env JANGAN di-commit (sudah ada di .gitignore).
# Cek hasilnya dengan: python scripts/check_setup.py

# --- Server: staging & production (laptop cukup biarkan default) ---
# dev = laptop (python run.py). staging / production = server (gunicorn, lihat docs/DEPLOY_SERVER.md). Selain dev,
# aplikasi menolak start kalau AUTH_DISABLED=1, FLASK_DEBUG=1, SESSION_COOKIE_SECURE bukan 1, atau secret key pendek.
APP_ENV=dev
# Jumlah reverse proxy (Caddy/nginx) di depan aplikasi: server = 1, laptop = 0. Jangan 1 tanpa proxy (header bisa dipalsukan)
TRUST_PROXY=0
# Folder database & backup. Kosong = instance/ di folder ini. Server: di luar folder kode, mis. /var/lib/mantra
MANTRA_INSTANCE_DIR=
# DEBUG / INFO / WARNING. Kosong = WARNING di dev, INFO di server (log per request & per query Power BI)
LOG_LEVEL=
# Lokasi file .env ini sendiri di server (mis. /etc/mantra/mantra.env) diset lewat environment proses
# (systemd: Environment=MANTRA_ENV_FILE=...), BUKAN di dalam file ini.

# --- Flask ---
# Port lokal (5000 dipakai project Material Readiness lama). Kalau diubah, redirect URI di Entra harus ikut diubah.
# Di server: port gunicorn di 127.0.0.1 (GUNICORN_BIND / GUNICORN_THREADS opsional, lihat gunicorn.conf.py).
PORT=5001
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# WAJIB 1 kalau portal dibuka lewat HTTPS. 0 hanya untuk http://localhost
SESSION_COOKIE_SECURE=0
# 1 = Werkzeug debugger + auto reload (hanya development; debugger bisa menjalankan kode di server)
FLASK_DEBUG=0
# Lama sesi login (jam)
SESSION_HOURS=8
# 1 = dashboard yang error membuat aplikasi gagal start (development). 0 = disembunyikan saja (production).
DASHBOARD_STRICT=1

# --- Login user ---
# Login utama: email + password (akun di instance/mantra.db). Akun awal: python scripts/manage_users.py seed
# Opsional: Microsoft Entra ID (app registration "MANTRA Portal"), hanya untuk email yang sudah terdaftar di MANTRA.
# Redirect URI yang didaftarkan: http://localhost:5001/auth/callback (port = PORT di atas)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Kolom "Value" dari client secret, BUKAN "Secret ID"
ENTRA_CLIENT_SECRET=

# 1 = tanpa login, otomatis masuk sebagai Super Admin development. JANGAN dipakai di production.
AUTH_DISABLED=0

# --- Data: Power BI service principal, app registration "mantra-powerbi" ---
# Tenant sama dengan login; PBI_TENANT_ID boleh dikosongkan (otomatis memakai ENTRA_TENANT_ID)
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
# Batas query ke Power BI per menit untuk SEMUA dashboard (kuota dihitung per service principal)
PBI_MAX_QUERIES_PER_MINUTE=100
# Berapa menit hasil query disimpan di memori sebelum diambil ulang
CACHE_MINUTES=10
# Batas waktu satu request ke Power BI (detik)
PBI_TIMEOUT_SECONDS=120

# Workspace/dataset tiap dashboard ada di mantra/dashboards/<nama>/queries.py.
# Bisa ditimpa di sini, mis. untuk dataset dev:
# MATERIAL_READINESS_WORKSPACE_ID=
# MATERIAL_READINESS_DATASET_ID=

# --- AI agent ---
# gemini (sekarang). Provider lain ditambahkan di mantra/core/chat/providers.py
AI_PROVIDER=gemini
# aistudio.google.com/apikey. Kosong = tombol "Ask AI" disembunyikan
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model cadangan kalau model utama sedang penuh / kena limit, pisahkan dengan koma
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest
# Batas pertanyaan AI agent per user per menit
CHAT_MAX_PER_MINUTE=10
