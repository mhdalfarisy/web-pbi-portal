VAR SEP_F = UNICHAR ( 57344 )
VAR SEP_R = UNICHAR ( 57345 )

-- Baris detail: qty dijumlahkan (SUM) per baris PS, sama seperti tabel visual lama
-- (sebelumnya qty dipakai sebagai kolom grouping sehingga baris yang identik ikut tergabung jadi satu)
-- Urutan field: 0 company | 1 PS | 2 seq | 3 type | 4 stock code | 5 unit | 6 job | 7 ordered | 8 shipped | 9 backorder
VAR jsRaw =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[company],
'sales_order_line'[dax_so_suffix],
'sales_order_line'[sol_line_seq],
'sales_order_line'[sol_line_type],
'sales_order_line'[stock_code],
'sales_order_line'[stk_unit_desc],
'sales_order_line'[job_code],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"oq", SUM ( 'sales_order_line'[sol_ordered_qty] ),
"sq", SUM ( 'sales_order_line'[sol_shipped_qty] ),
"bo", SUM ( 'sales_order_line'[backorder_qty] )
),
VAR rw = 'sales_order_line'[company] & "" & SEP_F & 'sales_order_line'[dax_so_suffix] & "" & SEP_F & FORMAT ( 'sales_order_line'[sol_line_seq], "0" ) & SEP_F & 'sales_order_line'[sol_line_type] & "" & SEP_F & 'sales_order_line'[stock_code] & "" & SEP_F & 'sales_order_line'[stk_unit_desc] & "" & SEP_F & 'sales_order_line'[job_code] & "" & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [oq], 0 ), "0.####" ), ",", "." ) & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [sq], 0 ), "0.####" ), ",", "." ) & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [bo], 0 ), "0.####" ), ",", "." ) RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

-- Urutan field ORD: 0 company|PS (key) | 1 company_so_suffix | 2 department | 3 dax_so_date_stamp | 4 order date | 5 delivery date | 6 status | 7 warehouse
VAR jsOrd =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[company],
'sales_order_line'[dax_so_suffix],
'sales_order_line'[dax_company_so_suffix],
'sales_order_line'[dax_department],
'sales_order_line'[dax_so_date_stamp],
'sales_order_line'[dax_so_order_date],
'sales_order_line'[dax_so_delivery_date],
'sales_order_line'[dax_so_order_status],
'sales_order_line'[dax_warehouse],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"n", COUNTROWS ( 'sales_order_line' )
),
VAR rw = 'sales_order_line'[company] & "|" & 'sales_order_line'[dax_so_suffix] & SEP_F & 'sales_order_line'[dax_company_so_suffix] & "" & SEP_F & 'sales_order_line'[dax_department] & "" & SEP_F & FORMAT ( 'sales_order_line'[dax_so_date_stamp], "yyyyMMdd" ) & SEP_F & FORMAT ( 'sales_order_line'[dax_so_order_date], "yyyyMMdd" ) & SEP_F & FORMAT ( 'sales_order_line'[dax_so_delivery_date], "yyyyMMdd" ) & SEP_F & 'sales_order_line'[dax_so_order_status] & "" & SEP_F & 'sales_order_line'[dax_warehouse] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsStk =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[company],
'sales_order_line'[stock_code],
'sales_order_line'[dax_warehouse],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"qh", MAX ( 'sales_order_line'[dax_qty_on_hand] ),
"qo", MAX ( 'sales_order_line'[dax_qty_on_order] ),
"ac", MAX ( 'sales_order_line'[dax_average_cost] )
),
VAR rw = 'sales_order_line'[company] & "|" & 'sales_order_line'[stock_code] & "|" & 'sales_order_line'[dax_warehouse] & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [qh], 0 ), "0.####" ), ",", "." ) & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [qo], 0 ), "0.####" ), ",", "." ) & SEP_F & SUBSTITUTE ( FORMAT ( COALESCE ( [ac], 0 ), "0.####" ), ",", "." ) RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsDesc =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[company],
'sales_order_line'[stock_code],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"ds", MAX ( 'stock_master'[dax_detail_description] )
),
VAR rw = 'sales_order_line'[company] & "|" & 'sales_order_line'[stock_code] & SEP_F & [ds] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsJob =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[company],
'sales_order_line'[job_code],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"ws", MAX ( 'sales_order_line'[dax_wo_status_category] ),
"pd", MAX ( 'sales_order_line'[project_description] )
),
VAR rw = 'sales_order_line'[company] & "|" & 'sales_order_line'[job_code] & SEP_F & [ws] & "" & SEP_F & [pd] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsStat =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[dax_so_order_status],
'sales_order_line'[dax_so_order_status_category],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"n", COUNTROWS ( 'sales_order_line' )
),
VAR rw = 'sales_order_line'[dax_so_order_status] & "" & SEP_F & 'sales_order_line'[dax_so_order_status_category] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsTer =
CONCATENATEX (
SUMMARIZECOLUMNS (
'sales_order_line'[dax_teritory_code],
'sales_order_line'[dax_teritory_description],
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) ),
"n", COUNTROWS ( 'sales_order_line' )
),
VAR rw = 'sales_order_line'[dax_teritory_code] & "" & SEP_F & 'sales_order_line'[dax_teritory_description] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR totalMasterCompCount = CALCULATE ( DISTINCTCOUNT ( 'DWMasterIconCompany'[Company Code] ), ALL ( 'DWMasterIconCompany' ) )

VAR jsComp =
CONCATENATEX (
SUMMARIZE ( 'DWMasterIconCompany', 'DWMasterIconCompany'[Company Code], 'DWMasterIconCompany'[Company Name], 'DWMasterIconCompany'[Company Group Color] ),
VAR rw = 'DWMasterIconCompany'[Company Code] & "" & SEP_F & 'DWMasterIconCompany'[Company Name] & "" & SEP_F & 'DWMasterIconCompany'[Company Group Color] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

VAR jsProj =
CONCATENATEX (
CALCULATETABLE (
SUMMARIZE ( 'project_commitment', 'project_commitment'[dax_company_so_suffix], 'project_commitment'[job_code], 'project_commitment'[project_description] ),
KEEPFILTERS ( FILTER ( ALL ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse] <> "ADV" ) ),
KEEPFILTERS ( TREATAS ( { "S" }, 'stock_master'[stk_stock_status] ) ),
KEEPFILTERS ( TREATAS ( { "SN" }, 'sales_order_line'[sol_line_type] ) )
),
VAR rw = 'project_commitment'[dax_company_so_suffix] & "" & SEP_F & 'project_commitment'[job_code] & "" & SEP_F & 'project_commitment'[project_description] & "" RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rw & "", "\", "\\" ), "'", "\'" ), UNICHAR ( 13 ), " " ), UNICHAR ( 10 ), " " ), "<", "\x3C" ),
SEP_R
)

-- ================= DETEKSI FILTER POWER BI =================
VAR fCompany =
    IF (
        ISFILTERED ( 'sales_order_line'[company] ),
        "c" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[company] ), 'sales_order_line'[company], ";" ) & SEP_R,
        IF (
            ISFILTERED ( 'DWMasterIconCompany'[Company Code] ),
            "c" & SEP_F & CONCATENATEX ( FILTERS ( 'DWMasterIconCompany'[Company Code] ), 'DWMasterIconCompany'[Company Code], ";" ) & SEP_R,
            IF (
                ISFILTERED ( 'DWMasterIconCompany'[Company Name] ),
                "cn_raw" & SEP_F & CONCATENATEX ( FILTERS ( 'DWMasterIconCompany'[Company Name] ), 'DWMasterIconCompany'[Company Name], ";" ) & SEP_R,
                ""
            )
        )
    )

VAR fPsNum   = IF ( ISFILTERED ( 'sales_order_line'[dax_so_suffix] ), "psn" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[dax_so_suffix] ), 'sales_order_line'[dax_so_suffix], ";" ) & SEP_R, "" )
VAR fPsItem  = IF ( ISFILTERED ( 'sales_order_line'[stock_code] ), "psi" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[stock_code] ), 'sales_order_line'[stock_code], ";" ) & SEP_R, "" )
VAR fPsStat  = IF ( ISFILTERED ( 'sales_order_line'[dax_so_order_status_category] ), "pss" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[dax_so_order_status_category] ), 'sales_order_line'[dax_so_order_status_category], ";" ) & SEP_R, "" )
VAR fUnit    = IF ( ISFILTERED ( 'sales_order_line'[stk_unit_desc] ), "u" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[stk_unit_desc] ), 'sales_order_line'[stk_unit_desc], ";" ) & SEP_R, "" )
VAR fWh      = IF ( ISFILTERED ( 'sales_order_line'[dax_warehouse] ), "w" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[dax_warehouse] ), 'sales_order_line'[dax_warehouse], ";" ) & SEP_R, "" )
VAR fTer     = IF ( ISFILTERED ( 'sales_order_line'[dax_teritory_description] ), "t" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[dax_teritory_description] ), 'sales_order_line'[dax_teritory_description], ";" ) & SEP_R, "" )
VAR fPsDesc  = IF ( ISFILTERED ( 'sales_order_line'[dax_department] ), "psd" & SEP_F & CONCATENATEX ( FILTERS ( 'sales_order_line'[dax_department] ), 'sales_order_line'[dax_department], ";" ) & SEP_R, "" )

VAR rawPbiFilters = fCompany & fPsNum & fPsItem & fPsStat & fUnit & fWh & fTer & fPsDesc

VAR jsPbiFilters =
    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( rawPbiFilters & "", "\", "\\" ), "'", "\'" ), UNICHAR(13), " " ), UNICHAR(10), " " )

VAR hdLastUpdate = FORMAT ( TODAY (), "dd/MM/yyyy" )

RETURN
"<!DOCTYPE html>
<html>
<head>
<meta charset='UTF-8'>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, sans-serif; }
html, body { width: 100%; height: 100%; background: #f4f7fb; overflow-x: hidden; overflow-y: auto; }
body { padding: 8px; }
.dash { display: flex; flex-direction: column; gap: 10px; height: calc(100vh - 16px); min-height: 520px; }
.hd {
--hd1: #1e3a8a; --hd2: #2563eb;
position: relative; flex-shrink: 0; border-radius: 12px; overflow: hidden; color: #ffffff;
background: linear-gradient(90deg, var(--hd1) 0%, var(--hd2) 100%);
box-shadow: 0 4px 12px rgba(15,23,42,0.1);
transition: background 0.3s ease;
}
.hd-deco { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.3; }
.hd-accent { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: #D97706; }
.hd-inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 20px 14px; }
.hd-left { display: flex; align-items: center; gap: 16px; flex: 1; min-width: 0; }
.hd-logo-box {
height: 50px; min-width: 140px; border-radius: 8px; background: #ffffff; flex-shrink: 0; overflow: hidden;
display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1); padding: 4px 12px;
}
.hd-logos { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 100%; }
.hd-logos.even { justify-content: space-evenly; }
.hd-logos img { height: 100%; max-height: 42px; max-width: 130px; object-fit: contain; }
.hd-title-block { display: flex; flex-direction: column; min-width: 0; }
.hd-title-row { display: flex; align-items: center; gap: 10px; min-width: 0; }
.hd-main-title { font-size: 18px; font-weight: 800; white-space: nowrap; color: #ffffff; }
.hd-pill {
display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; flex-shrink: 0;
background: rgba(0,0,0,0.25); border: 1px solid rgba(252,211,77,0.6); color: #fde047;
font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;
}
.hd-pill-dot { width: 6px; height: 6px; border-radius: 50%; background: #facc15; box-shadow: 0 0 4px #facc15; }
.hd-desc { font-size: 11px; color: rgba(255,255,255,0.9); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hd-crumb {
display: inline-flex; align-self: flex-start; align-items: center; gap: 5px; margin-top: 5px;
padding: 3px 10px; border-radius: 6px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2);
font-size: 10px; max-width: 100%;
}
.hd-crumb svg { width: 12px; height: 12px; color: #93c5fd; flex-shrink: 0; }
.hd-crumb-label { color: rgba(255,255,255,0.8); font-weight: 600; }
.hd-crumb-sep { color: rgba(255,255,255,0.5); }
.hd-crumb-value { color: #ffffff; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hd-stat {
display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-radius: 8px; flex-shrink: 0;
background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2);
}
.hd-stat-ic { width: 30px; height: 30px; border-radius: 6px; background: rgba(0,0,0,0.1); color: #fde047; display: flex; align-items: center; justify-content: center; }
.hd-stat-ic svg { width: 16px; height: 16px; }
.hd-stat small { display: block; font-size: 9.5px; color: rgba(255,255,255,0.8); font-weight: 600; }
.hd-stat b { display: block; font-size: 13.5px; font-weight: 800; color: #ffffff; line-height: 1.2; margin-top: 1px; }
.sb {
background: #ffffff; border: 1px solid #e6ebf2; border-radius: 12px; box-shadow: 0 2px 10px rgba(15,23,42,.05);
padding: 10px 14px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 14px; position: relative; z-index: 50;
}
.sb-item { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1 1 165px; }
.sb-item.fix { flex: 0 0 auto; }
.sb-ic { width: 30px; height: 30px; border-radius: 8px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sb-ic svg { width: 15px; height: 15px; }
.sb-field { flex: 1; min-width: 0; }
.sb-label { font-size: 10.5px; font-weight: 600; color: #0f172a; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.w-td .sb-field { width: 56px; } .w-yr .sb-field { width: 86px; } .w-mo .sb-field { width: 82px; } .w-dy .sb-field { width: 66px; }
.ms { position: relative; width: 100%; }
.ms-btn {
width: 100%; height: 28px; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff;
padding: 0 20px 0 8px; font-size: 10.5px; color: #0f172a; text-align: left; cursor: pointer;
white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; outline: none;
}
.ms-btn::after { content: '\25BE'; position: absolute; right: 7px; top: 6px; font-size: 10px; color: #64748b; }
.ms-btn:focus { border-color: #2563eb; }
.ms-btn.is-active { border-color: #2563eb; background: #eff6ff; color: #1d4ed8; font-weight: 600; }
.ms-panel {
display: none; position: absolute; top: 32px; left: 0; min-width: 240px; max-width: 360px;
background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 10px 25px rgba(15,23,42,.2); z-index: 1000;
}
.ms.right .ms-panel { left: auto; right: 0; }
.ms.open .ms-panel { display: block; }
.ms-tools { display: flex; gap: 4px; padding: 6px; border-bottom: 1px solid #eef2f7; }
.ms-search { flex: 1; min-width: 0; height: 24px; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0 6px; font-size: 10.5px; outline: none; }
.ms-search:focus { border-color: #2563eb; }
.ms-clear { height: 24px; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 4px; padding: 0 8px; font-size: 10px; font-weight: 700; color: #475569; cursor: pointer; }
.ms-list { max-height: 260px; overflow-y: auto; padding: 4px; }
.ms-opt { display: flex; align-items: center; gap: 6px; padding: 4px 6px; font-size: 10.5px; color: #0f172a; cursor: pointer; border-radius: 4px; }
.ms-opt:hover { background: #f1f5ff; }
.ms-opt.is-on { background: #eff6ff; font-weight: 600; }
.ms-opt input { pointer-events: none; flex-shrink: 0; }
.ms-opt .t { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ms-opt .ms-cnt { font-size: 10px; font-weight: 600; color: #64748b; margin-left: 6px; flex-shrink: 0; }
.ms-opt.is-on .ms-cnt { color: #2563eb; }
.ms-note { font-size: 10px; color: #94a3b8; padding: 6px; }
.sb-select { width: 100%; height: 28px; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; padding: 0 4px; font-size: 10.5px; color: #0f172a; outline: none; cursor: pointer; }
.sb-select.is-active { border-color: #2563eb; background: #eff6ff; color: #1d4ed8; font-weight: 600; }
.sb-btn-today { width: 100%; height: 28px; border-radius: 6px; background: #ffffff; color: #475569; border: 1px solid #cbd5e1; cursor: pointer; font-size: 10.5px; font-weight: 700; outline: none; }
.sb-btn-today.is-active { background: linear-gradient(90deg, #2563eb, #3b82f6); color: #ffffff; border-color: #2563eb; }
.sb-reset {
height: 32px; border-radius: 8px; background: linear-gradient(90deg, #2563eb, #3b82f6); color: #ffffff; flex-shrink: 0;
border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; margin-left: auto;
font-size: 11px; font-weight: 700; box-shadow: 0 4px 12px rgba(37,99,235,.25); padding: 0 18px;
}
.sb-reset svg { width: 13px; height: 13px; }
.sb { flex-shrink: 0; }
.tc { flex: 1; min-height: 280px; background: #ffffff; border: 1px solid #e6ebf2; border-radius: 12px; box-shadow: 0 2px 10px rgba(15,23,42,.05); display: flex; flex-direction: column; overflow: hidden; }
.tc-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; flex-wrap: wrap; }
.tc-title { display: flex; align-items: center; gap: 12px; }
.tc-ic { width: 36px; height: 36px; border-radius: 8px; background: #2563eb; color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 8px rgba(37,99,235,.3); }
.tc-ic svg { width: 19px; height: 19px; }
.tc-t { font-size: 15px; font-weight: 800; color: #1e3a8a; }
.tc-st { font-size: 10.5px; color: #64748b; margin-top: 2px; }
.tc-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.tc-search { position: relative; display: flex; align-items: center; height: 32px; width: 300px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 10px; gap: 6px; background: #ffffff; }
.tc-search:focus-within { border-color: #2563eb; }
.tc-search svg { width: 14px; height: 14px; color: #2563eb; flex-shrink: 0; }
.tc-search input { border: 0; outline: none; flex: 1; min-width: 0; font-size: 11px; color: #0f172a; background: transparent; }
.cc { position: relative; }
.cc-btn, .tc-copy { height: 32px; border: 1px solid #cbd5e1; border-radius: 8px; background: #ffffff; display: flex; align-items: center; gap: 6px; padding: 0 12px; font-size: 11px; font-weight: 700; color: #1e3a8a; cursor: pointer; }
.cc-btn::after { content: '\25BE'; font-size: 10px; color: #64748b; margin-left: 6px; }
.cc-btn svg, .tc-copy svg { width: 14px; height: 14px; color: #2563eb; }
.cc-btn.is-active { border-color: #2563eb; background: #eff6ff; }
.tc-copy { background: linear-gradient(90deg, #2563eb, #3b82f6); color: #ffffff; border: 0; box-shadow: 0 4px 12px rgba(37,99,235,.25); }
.tc-copy svg { color: #ffffff; }
.cc-panel { display: none; position: absolute; right: 0; top: 36px; width: 230px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 10px 25px rgba(15,23,42,.2); z-index: 60; }
.cc.open .cc-panel { display: block; }
.cc-tools { display: flex; gap: 4px; padding: 6px; border-bottom: 1px solid #eef2f7; }
.cc-all { flex: 1; height: 24px; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 4px; font-size: 10px; font-weight: 700; color: #475569; cursor: pointer; }
.cc-list { max-height: 260px; overflow-y: auto; padding: 4px; }
.tb-wrap { flex: 1; min-height: 0; overflow: auto; margin: 0 16px; border: 1px solid #e2e8f0; border-radius: 10px 10px 0 0; }
.tb { border-collapse: separate; border-spacing: 0; width: max-content; min-width: 100%; font-size: 10.5px; }
.tb th {
position: sticky; top: 0; z-index: 2; background: #1e3a8a; color: #ffffff; font-weight: 700; text-align: center;
padding: 8px 10px; border-right: 1px solid rgba(255,255,255,.15); white-space: nowrap; cursor: pointer; user-select: none; line-height: 1.25;
}
.tb th:hover { background: #1d4ed8; }
.tb th .si { display: inline-block; margin-left: 4px; font-size: 8px; opacity: .6; }
.tb th.sorted .si { opacity: 1; color: #fde047; }
.tb td { padding: 7px 10px; border-bottom: 1px solid #eef2f7; border-right: 1px solid #f1f5f9; color: #334155; white-space: nowrap; cursor: copy; max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
.tb tbody tr:nth-child(even) td { background: #f8fafc; }
.tb tbody tr:hover td { background: #eff6ff; }
.tb td.n { text-align: right; font-variant-numeric: tabular-nums; }
.tb td.c { text-align: center; }
.tb td.cp { background: #dbeafe !important; outline: 1px solid #2563eb; outline-offset: -1px; }
.tb tfoot td { position: sticky; bottom: 0; z-index: 1; background: #ffffff; font-weight: 800; color: #1e3a8a; border-top: 2px solid #cbd5e1; cursor: default; }
.tb .st-ok { color: #16a34a; font-weight: 600; }
.tb .st-warn { color: #f59e0b; font-weight: 600; }
.tb .st-bad { color: #ef4444; font-weight: 600; }
.tb .st-info { color: #2563eb; font-weight: 600; }
.tb-empty { padding: 30px; text-align: center; color: #94a3b8; font-weight: 600; font-size: 12px; }
.tc-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 16px; border-top: 1px solid #eef2f7; flex-wrap: wrap; }
.tc-info { display: flex; align-items: center; gap: 14px; font-size: 10.5px; color: #64748b; }
.tc-ps { display: flex; align-items: center; gap: 5px; }
.tc-ps select { height: 24px; border: 1px solid #cbd5e1; border-radius: 5px; font-size: 10.5px; outline: none; }
.pg { display: flex; gap: 4px; }
.pg button { min-width: 28px; height: 28px; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; font-size: 10.5px; font-weight: 600; color: #334155; cursor: pointer; padding: 0 6px; }
.pg button.on { background: #2563eb; border-color: #2563eb; color: #ffffff; }
.pg button:disabled { opacity: .4; cursor: default; }
.pg .dots { padding: 0 4px; line-height: 28px; color: #94a3b8; font-size: 11px; }
.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(20px); background: #0f172a; color: #ffffff; font-size: 11px; font-weight: 600; padding: 8px 14px; border-radius: 8px; opacity: 0; pointer-events: none; transition: all .2s; z-index: 3000; max-width: 70%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }
.cpm { display: none; position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 4000; align-items: center; justify-content: center; }
.cpm.on { display: flex; }
.cpm-box { width: min(640px, 90%); background: #ffffff; border-radius: 10px; padding: 12px; box-shadow: 0 20px 40px rgba(0,0,0,.3); }
.cpm-h { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700; color: #1e3a8a; margin-bottom: 8px; }
.cpm-h button { border: 0; background: none; font-size: 18px; cursor: pointer; color: #64748b; }
.cpm textarea { width: 100%; height: 220px; font-family: Consolas, monospace; font-size: 11px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px; }
</style>
</head>
<body>
<div class='dash'>
<div class='hd'>
<svg class='hd-deco' viewBox='0 0 1200 100' preserveAspectRatio='xMaxYMid slice'>
<path d='M0 60 C 300 20, 600 100, 900 60 S 1200 40, 1200 60 L1200 100 L0 100 Z' fill='rgba(255,255,255,0.05)'/>
<path d='M0 80 C 400 120, 800 20, 1200 80 L1200 100 L0 100 Z' fill='rgba(255,255,255,0.04)'/>
</svg>
<div class='hd-inner'>
<div class='hd-left'>
<div class='hd-logo-box' id='hdLogoBox'></div>
<div class='hd-title-block'>
<div class='hd-title-row'>
<div class='hd-main-title'>Picking Slip Summary</div>
<span class='hd-pill'><span class='hd-pill-dot'></span>Summary</span>
</div>
<div class='hd-desc'>Summary of Picking Slip Orders and Status</div>
<div class='hd-crumb'>
<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='3' width='16' height='18' rx='1'/><path d='M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3'/></svg>
<span class='hd-crumb-label'>Entity</span>
<span class='hd-crumb-sep'>&#8250;</span>
<span class='hd-crumb-value' id='hdEntity'>All Companies</span>
</div>
</div>
</div>
<div class='hd-stat'>
<div class='hd-stat-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4M9 15.5l2 2 4-4'/></svg></div>
<div><small>Last Update</small><b>" & hdLastUpdate & "</b></div>
</div>
</div>
<div class='hd-accent'></div>
</div>
<div class='sb'>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='3' width='16' height='18' rx='1'/><path d='M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3'/></svg></div><div class='sb-field'><div class='sb-label'>Company</div><div id='sbCompany' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><line x1='4' y1='9' x2='20' y2='9'/><line x1='4' y1='15' x2='20' y2='15'/><line x1='10' y1='3' x2='8' y2='21'/><line x1='16' y1='3' x2='14' y2='21'/></svg></div><div class='sb-field'><div class='sb-label'>WO Code</div><div id='sbWoCode' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/></svg></div><div class='sb-field'><div class='sb-label'>PS Number</div><div id='sbPsNum' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'/><polyline points='3.27 6.96 12 12.01 20.73 6.96'/><line x1='12' y1='22.08' x2='12' y2='12'/></svg></div><div class='sb-field'><div class='sb-label'>PS Item</div><div id='sbPsItem' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg></div><div class='sb-field'><div class='sb-label'>PS Status</div><div id='sbPsStat' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'/><line x1='7' y1='7' x2='7.01' y2='7'/></svg></div><div class='sb-field'><div class='sb-label'>Unit Description</div><div id='sbUnitDesc' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 21V8l9-5 9 5v13'/><path d='M7 21v-8h10v8'/><path d='M7 17h10'/></svg></div><div class='sb-field'><div class='sb-label'>Warehouse</div><div id='sbWh' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22s-7-7.6-7-12a7 7 0 0 1 14 0c0 4.4-7 12-7 12z'/><circle cx='12' cy='10' r='2.5'/></svg></div><div class='sb-field'><div class='sb-label'>Territory Description</div><div id='sbTer' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2 2 7l10 5 10-5z'/><path d='m2 12 10 5 10-5'/><path d='m2 17 10 5 10-5'/></svg></div><div class='sb-field'><div class='sb-label'>PS Description</div><div id='sbPsDesc' class='ms'></div></div></div>
<div class='sb-item'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 3h6a1 1 0 0 1 1 1v1h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2V4a1 1 0 0 1 1-1z'/><path d='M8 12h8M8 16h5'/></svg></div><div class='sb-field'><div class='sb-label'>WO Description</div><div id='sbWoDesc' class='ms'></div></div></div>
<div class='sb-item fix w-td'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg></div><div class='sb-field'><div class='sb-label'>Today</div><button type='button' id='btnToday' class='sb-btn-today'>Off</button></div></div>
<div class='sb-item fix w-yr'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg></div><div class='sb-field'><div class='sb-label'>Year</div><select id='sbYr' class='sb-select'></select></div></div>
<div class='sb-item fix w-mo'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg></div><div class='sb-field'><div class='sb-label'>Month</div><select id='sbMo' class='sb-select'></select></div></div>
<div class='sb-item fix w-dy'><div class='sb-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg></div><div class='sb-field'><div class='sb-label'>Day</div><select id='sbDy' class='sb-select'></select></div></div>
<button type='button' id='btnReset' class='sb-reset'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12a9 9 0 1 0 3-6.7'/><path d='M3 3v5h5'/></svg> Reset</button>
</div>
<div class='tc'>
<div class='tc-head'>
<div class='tc-title'>
<div class='tc-ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 10h18M9 10v10M15 10v10'/></svg></div>
<div><div class='tc-t'>Picking Slip Detail</div><div class='tc-st'>Complete list of picking slip records &middot; click any cell to copy</div></div>
</div>
<div class='tc-tools'>
<div class='tc-search'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg><input type='text' id='tbSearch' placeholder='Search PS No, Item Code, Warehouse...'></div>
<div class='cc' id='ccBox'>
<button type='button' class='cc-btn' id='ccBtn'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3'/></svg><span id='ccLbl'>All Columns</span></button>
<div class='cc-panel'>
<div class='cc-tools'><button type='button' class='cc-all' id='ccAll'>Show All</button><button type='button' class='cc-all' id='ccNone'>Hide All</button></div>
<div class='cc-list' id='ccList'></div>
</div>
</div>
<button type='button' class='tc-copy' id='btnCopyTbl' title='Copy all filtered rows (ready to paste into Excel)'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='9' y='9' width='13' height='13' rx='2'/><path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'/></svg> Copy Table</button>
</div>
</div>
<div class='tb-wrap' id='tbWrap'><table class='tb' id='tb'></table></div>
<div class='tc-foot'>
<div class='tc-info'><span id='tbInfo'>-</span>
<label class='tc-ps'>Rows <select id='tbSize'><option>15</option><option>25</option><option>50</option><option>100</option><option value='250'>250</option><option value='500'>500</option><option value='999999' selected>All</option></select></label>
</div>
<div class='pg' id='tbPg'></div>
</div>
</div>
</div>
<div class='toast' id='toast'></div>
<div class='cpm' id='cpm'><div class='cpm-box'><div class='cpm-h'>Press Ctrl+C to copy<button type='button' id='cpmX'>&times;</button></div><textarea id='cpmTa' readonly></textarea></div></div>
<script>
var RAW_TXT  = '" & jsRaw & "';
var ORD_TXT  = '" & jsOrd & "';
var STK_TXT  = '" & jsStk & "';
var DESC_TXT = '" & jsDesc & "';
var JOB_TXT  = '" & jsJob & "';
var STAT_TXT = '" & jsStat & "';
var TER_TXT  = '" & jsTer & "';
var COMP_TXT = '" & jsComp & "';
var PROJ_TXT = '" & jsProj & "';
var PBI_FILTERS_TXT = '" & jsPbiFilters & "';
var TOTAL_MASTER_COMP = " & totalMasterCompCount & ";
// Pemisah field / baris (sama dengan UNICHAR 57344 / 57345 di DAX)
var SF = '', SR = '';
var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
var SLICERS = [
{ id: 'sbCompany',  key: 'cn',  label: 'All Companies' },
{ id: 'sbWoCode',   key: 'wc',  label: 'All WO Codes' },
{ id: 'sbPsNum',    key: 'psn', label: 'All PS Numbers' },
{ id: 'sbPsItem',   key: 'psi', label: 'All PS Items' },
{ id: 'sbPsStat',   key: 'pss', label: 'All PS Status' },
{ id: 'sbUnitDesc', key: 'u',   label: 'All Units' },
{ id: 'sbWh',       key: 'w',   label: 'All Warehouses' },
{ id: 'sbTer',      key: 't',   label: 'All Territories' },
{ id: 'sbPsDesc',   key: 'psd', label: 'All PS Descriptions' },
{ id: 'sbWoDesc',   key: 'wod', label: 'All WO Descriptions' }
];
var COLS = [
{ k: 'c',    h: 'Company Code',          t: 's', a: 'c' },
{ k: 'cn',   h: 'Company Name',          t: 's' },
{ k: 'psn',  h: 'PS Number',             t: 's' },
{ k: 'seq',  h: 'Sequence',              t: 'i', a: 'c' },
{ k: 'typ',  h: 'Type',                  t: 's', a: 'c' },
{ k: 'psi',  h: 'Item Code',             t: 's' },
{ k: 'u',    h: 'PS Unit Description',   t: 's', a: 'c' },
{ k: 'ides', h: 'Item Description',      t: 's' },
{ k: 'qoh',  h: 'Quantity On Hand',      t: 'n', sum: 1 },
{ k: 'qoo',  h: 'Quantity PO On Order',  t: 'n', sum: 1 },
{ k: 'job',  h: 'WO Number',             t: 's' },
{ k: 'jobd', h: 'WO Description',         t: 's' },
{ k: 'wos',  h: 'WO Status',              t: 's', st: 1 },
{ k: 'psd',  h: 'Department',             t: 's' },
{ k: 'tc',   h: 'Territory Code',         t: 's', a: 'c' },
{ k: 't',    h: 'Territory Description',  t: 's' },
{ k: 'dus',  h: 'Update Date',            t: 'd', a: 'c' },
{ k: 'dor',  h: 'Date',                   t: 'd', a: 'c' },
{ k: 'drq',  h: 'Required Date',          t: 'd', a: 'c' },
{ k: 'sts',  h: 'Status',                 t: 's' },
{ k: 'pss',  h: 'Status Category',        t: 's', st: 1 },
{ k: 'cost', h: 'Line Item Cost',         t: 'n' },
{ k: 'w',    h: 'Warehouse',              t: 's', a: 'c' },
{ k: 'oq',   h: 'SO Order Quantity',      t: 'n', sum: 1 },
{ k: 'sq',   h: 'Shipped Quantity',       t: 'n', sum: 1 },
{ k: 'bo',   h: 'Backorder',              t: 'n', sum: 1 },
{ k: 'amt',  h: 'Total Amount',           t: 'n', sum: 1 },
{ k: 'samt', h: 'Total Shipped Amount',   t: 'n', sum: 1 }
];
// Default: Year / Month / Day = All, Today = Off, Rows = All
var DATA = [], FS = {}, DSEL = { y: 0, m: 0, d: 0 };
var todayOn = false, cachedDate = null, MS_OPEN = '', INITED = false, ALL_COMP = 0;
var VIEW = [], PAGE = 1, PSIZE = 999999, SORT = { k: '', dir: 1 }, HIDE = Object.create(null), QRY = '';

function el(id) { return document.getElementById(id); }
function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;').replace(/\x22/g, '&quot;'); }
function cmp(a, b) { return String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' }); }
function num(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }
function fmtN(n, dec) { return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }); }
function fmtD(v) { v = String(v || ''); return v.length === 8 ? v.substr(6, 2) + '/' + v.substr(4, 2) + '/' + v.substr(0, 4) : ''; }
function cellText(r, c) {
var v = r[c.k];
if (c.t === 'n') return fmtN(v, 2);
if (c.t === 'i') return v === '' || v == null ? '' : String(v);
if (c.t === 'd') return fmtD(v);
return v == null ? '' : String(v);
}
function rawText(r, c) {
var v = r[c.k];
if (c.t === 'n') return String(Math.round(num(v) * 100) / 100);
if (c.t === 'd') return fmtD(v);
return v == null ? '' : String(v);
}
function stCls(v) {
var s = String(v || '').toLowerCase();
if (/overdue|hold|cancel|closed - not|reject/.test(s)) return 'st-bad';
if (/complete|finish|closed|invoic|shipped/.test(s)) return 'st-ok';
if (/pending|backorder|progress|printed|waiting/.test(s)) return 'st-warn';
if (/ready|open|entered/.test(s)) return 'st-info';
return '';
}
function dict(txt, nVal) {
var m = Object.create(null);
if (!txt) return m;
var rs = txt.split(SR);
for (var i = 0; i < rs.length; i++) {
var p = rs[i].split(SF);
if (p.length < nVal + 1 || (p[0] in m)) continue;
m[p[0]] = nVal === 1 ? p[1] : p.slice(1);
}
return m;
}

var COMP_COLOR = Object.create(null);
var COMP_NAME_TO_CODE = Object.create(null);

function parseData() {
DATA = [];
var comp = dict(COMP_TXT, 2), proj = dict(PROJ_TXT, 2), ord = dict(ORD_TXT, 7), stk = dict(STK_TXT, 3), desc = dict(DESC_TXT, 1),
job = dict(JOB_TXT, 2), stat = dict(STAT_TXT, 1), ter = dict(TER_TXT, 1), seen = Object.create(null);

for (var cc in comp) {
    var cName = comp[cc][0], cColor = comp[cc][1];
    if (cColor) COMP_COLOR[cName] = cColor;
    COMP_NAME_TO_CODE[cName.toLowerCase()] = cc;
    COMP_NAME_TO_CODE[cc.toLowerCase()] = cc;
}

if (!RAW_TXT) return;
var rows = RAW_TXT.split(SR), NO = ['', '', '', '', '', '', ''], NS = ['0', '0', '0'], NJ = ['', ''];
for (var i = 0; i < rows.length; i++) {
var p = rows[i].split(SF);
if (p.length < 10) continue;
// o: 0 company_so_suffix | 1 department | 2 dax_so_date_stamp | 3 order date | 4 delivery date | 5 status | 6 warehouse
var c = p[0], o = ord[c + '|' + p[1]] || NO, wh = o[6];
var s = stk[c + '|' + p[4] + '|' + wh] || NS, jb = job[c + '|' + p[6]] || NJ, pj = proj[o[0]] || ['', ''];
var dept = o[1], tc = dept.substr(6, 2);
// Slicer Year / Month / Day diambil dari sales_order_line[dax_so_date_stamp]
var cost = num(s[2]), oq = num(p[7]), sq = num(p[8]), dt = parseInt(o[2], 10) || 0;
if (!(c in seen)) { seen[c] = 1; ALL_COMP++; }
var compName = comp[c] ? comp[c][0] : c;
DATA.push({
c: c, cn: compName, wc: pj[0], wod: pj[1], psn: p[1], seq: p[2], typ: p[3], psi: p[4], u: p[5],
ides: desc[c + '|' + p[4]] || '', qoh: num(s[0]), qoo: num(s[1]), job: p[6], jobd: jb[1], wos: jb[0],
psd: dept, tc: tc, t: ter[tc] || '', dus: o[2], dor: o[3], drq: o[4], sts: o[5], pss: stat[o[5]] || '',
cost: cost, w: wh, oq: oq, sq: sq, bo: num(p[9]), amt: cost * oq, samt: cost * sq,
y: Math.floor(dt / 10000), m: Math.floor(dt / 100) % 100, d: dt % 100
});
}
}

function getSl(id) { for (var i = 0; i < SLICERS.length; i++) if (SLICERS[i].id === id) return SLICERS[i]; return null; }
function selOf(id) { return FS[id] || (FS[id] = { v: Object.create(null), n: 0 }); }
function inPeriod(r) { return (!DSEL.y || r.y === DSEL.y) && (!DSEL.m || r.m === DSEL.m) && (!DSEL.d || r.d === DSEL.d); }

function passSlicers(r, skipId) {
for (var k = 0; k < SLICERS.length; k++) {
var s = SLICERS[k], sel = FS[s.id];
if (s.id === skipId) continue;
if (sel && sel.n && !(r[s.key] in sel.v)) return false;
}
return true;
}

function calcOpts() {
var sets = {}, counts = {};
SLICERS.forEach(function (s) {
    sets[s.id] = Object.create(null);
    counts[s.id] = Object.create(null);
    var sel = selOf(s.id);
    for (var v in sel.v) sets[s.id][v] = 1;
});
for (var i = 0; i < DATA.length; i++) {
    var r = DATA[i];
    if (!inPeriod(r)) continue;
    for (var k = 0; k < SLICERS.length; k++) {
        var s = SLICERS[k];
        if (passSlicers(r, s.id)) {
            var val = r[s.key];
            sets[s.id][val] = 1;
            counts[s.id][val] = (counts[s.id][val] || 0) + 1;
        }
    }
}
SLICERS.forEach(function (s) {
    s.opts = Object.keys(sets[s.id]).sort(cmp);
    s.counts = counts[s.id];
});
}

function buildSlicers() {
SLICERS.forEach(function (s, i) {
var box = el(s.id);
if (!box) return;
if (i >= SLICERS.length - 3) box.classList.add('right');
box.innerHTML =
'<button type=\'button\' class=\'ms-btn\' data-sl=\'' + s.id + '\'></button>' +
'<div class=\'ms-panel\'>' +
'<div class=\'ms-tools\'><input type=\'text\' class=\'ms-search\' data-sl=\'' + s.id + '\' placeholder=\'Search...\'>' +
'<button type=\'button\' class=\'ms-clear\' data-sl=\'' + s.id + '\'>Clear</button></div>' +
'<div class=\'ms-list\'></div>' +
'</div>';
});
}

function applyPbiFilters() {
if (!PBI_FILTERS_TXT) return;
var comp = dict(COMP_TXT, 2);
var entries = PBI_FILTERS_TXT.split(SR);
entries.forEach(function (ent) {
var parts = ent.split(SF);
if (parts.length < 2) return;
var key = parts[0], rawVals = parts[1].split(';');
var targetKey = (key === 'c' || key === 'cn_raw') ? 'cn' : key;
var targetSlicer = null;
for (var i = 0; i < SLICERS.length; i++) {
if (SLICERS[i].key === targetKey) { targetSlicer = SLICERS[i]; break; }
}
if (!targetSlicer) return;
var sel = selOf(targetSlicer.id);
rawVals.forEach(function (v) {
var finalVal = v;
if (key === 'c' && comp[v]) finalVal = comp[v][0];
if (!(finalVal in sel.v)) {
sel.v[finalVal] = 1;
sel.n++;
}
});
});
}

function renderOpts(s) {
var box = el(s.id);
if (!box) return;
var list = box.querySelector('.ms-list'), inp = box.querySelector('.ms-search');
var q = inp ? inp.value.toLowerCase().trim() : '';
var sel = selOf(s.id), h = '', shown = 0, total = 0, LIM = 300;
for (var i = 0; i < s.opts.length; i++) {
var v = s.opts[i], txt = v === '' ? '(Blank)' : v;
if (q && txt.toLowerCase().indexOf(q) < 0) continue;
total++;
if (shown >= LIM) continue;
shown++;
var on = v in sel.v;
var cnt = (s.counts && s.counts[v]) ? s.counts[v] : 0;
h += '<div class=\'ms-opt' + (on ? ' is-on' : '') + '\' data-sl=\'' + s.id + '\' data-i=\'' + i + '\'>' +
'<input type=\'checkbox\' tabindex=\'-1\'' + (on ? ' checked' : '') + '>' +
'<span class=\'t\' title=\'' + esc(txt) + '\'>' + esc(txt) + '</span>' +
'<span class=\'ms-cnt\'>(' + fmtN(cnt, 0) + ')</span></div>';
}
if (!total) h = '<div class=\'ms-note\'>No results</div>';
else if (total > shown) h += '<div class=\'ms-note\'>Showing ' + shown + ' of ' + total + '. Type to search.</div>';
list.innerHTML = h;
}

function updateBtn(s) {
var box = el(s.id), btn = box && box.querySelector('.ms-btn');
if (!btn) return;
var sel = selOf(s.id);
var isAll = false;
if (s.id === 'sbCompany') {
    isAll = (!sel.n) || (TOTAL_MASTER_COMP > 0 && sel.n >= TOTAL_MASTER_COMP);
} else {
    isAll = (!sel.n) || (s.opts && sel.n >= s.opts.length);
}

if (isAll) {
btn.textContent = s.label;
btn.classList.remove('is-active');
}
else if (sel.n === 1) {
var k;
for (k in sel.v) break;
btn.textContent = k === '' ? '(Blank)' : k;
btn.classList.add('is-active');
}
else {
btn.textContent = sel.n + ' Selected';
btn.classList.add('is-active');
}
btn.title = btn.textContent;
}

function refreshSlicers() { calcOpts(); SLICERS.forEach(function (s) { renderOpts(s); updateBtn(s); }); }

function toggleOpt(id, i) {
var s = getSl(id);
if (!s) return;
var v = s.opts[i], sel = selOf(id);
if (v in sel.v) { delete sel.v[v]; sel.n--; } else { sel.v[v] = 1; sel.n++; }
PAGE = 1; applyFilters();
}

function clearSlicer(id) { FS[id] = { v: Object.create(null), n: 0 }; PAGE = 1; applyFilters(); }

function closeAll() {
if (MS_OPEN) msToggleOpen(MS_OPEN);
var ccBox = el('ccBox');
if (ccBox) ccBox.classList.remove('open');
}

function msToggleOpen(id) {
MS_OPEN = (MS_OPEN === id) ? '' : id;
SLICERS.forEach(function (s) { var b = el(s.id); if (b) b.classList.toggle('open', s.id === MS_OPEN); });
if (MS_OPEN) {
    var ccBox = el('ccBox');
    if (ccBox) ccBox.classList.remove('open');
    var inp = el(MS_OPEN).querySelector('.ms-search');
    if (inp) inp.focus();
}
}

function daysIn(y, m) { if (!m) return 31; return new Date(Date.UTC(y || 2000, m, 0)).getUTCDate(); }

function fillSel(id, items, cur) {
var s = el(id), h = '';
items.forEach(function (it) { h += '<option value=\'' + it[0] + '\'' + (String(it[0]) === String(cur) ? ' selected' : '') + '>' + esc(it[1]) + '</option>'; });
s.innerHTML = h;
s.classList.toggle('is-active', +cur > 0);
}

// Daftar Year / Month / Day diambil dari sales_order_line[dax_so_date_stamp] (field y, m, d di DATA)
function renderDate() {
var years = [], ySeen = {}, months = [], mSeen = {}, days = [], dSeen = {};
DATA.forEach(function (r) {
if (!r.y) return;
if (!ySeen[r.y]) { ySeen[r.y] = 1; years.push(r.y); }
if (DSEL.y && r.y !== DSEL.y) return;
if (r.m && !mSeen[r.m]) { mSeen[r.m] = 1; months.push(r.m); }
if (DSEL.m && r.m !== DSEL.m) return;
if (r.d && !dSeen[r.d]) { dSeen[r.d] = 1; days.push(r.d); }
});
if (DSEL.y && !ySeen[DSEL.y]) years.push(DSEL.y);
if (DSEL.m && !mSeen[DSEL.m]) months.push(DSEL.m);
if (DSEL.d && !dSeen[DSEL.d]) days.push(DSEL.d);
years.sort(function (a, b) { return b - a; });
months.sort(function (a, b) { return a - b; });
days.sort(function (a, b) { return a - b; });
fillSel('sbYr', [[0, 'All']].concat(years.map(function (y) { return [y, y]; })), DSEL.y);
fillSel('sbMo', [[0, 'All']].concat(months.map(function (m) { return [m, MON[m - 1]]; })), DSEL.m);
fillSel('sbDy', [[0, 'All']].concat(days.map(function (d) { return [d, d]; })), DSEL.d);
}

function onDateChange() {
if (todayOn) setTodayBtn(false);
DSEL = { y: +el('sbYr').value || 0, m: +el('sbMo').value || 0, d: +el('sbDy').value || 0 };
PAGE = 1; renderDate(); applyFilters();
}

function setTodayBtn(on) { todayOn = on; var b = el('btnToday'); b.classList.toggle('is-active', on); b.textContent = on ? 'On' : 'Off'; }

function toggleToday() {
if (todayOn) { setTodayBtn(false); DSEL = cachedDate || { y: 0, m: 0, d: 0 }; }
else {
cachedDate = { y: DSEL.y, m: DSEL.m, d: DSEL.d };
var n = new Date();
DSEL = { y: n.getFullYear(), m: n.getMonth() + 1, d: n.getDate() };
setTodayBtn(true);
}
PAGE = 1; renderDate(); applyFilters();
}

function visCols() { return COLS.filter(function (c) { return !HIDE[c.k]; }); }

function buildView() {
var q = QRY.toLowerCase(), vc = visCols(), out = [];
for (var i = 0; i < DATA.length; i++) {
var r = DATA[i];
if (!inPeriod(r) || !passSlicers(r, '')) continue;
if (q) {
var hit = false;
for (var j = 0; j < vc.length && !hit; j++) { if (cellText(r, vc[j]).toLowerCase().indexOf(q) >= 0) hit = true; }
if (!hit) continue;
}
out.push(r);
}
if (SORT.k) {
var c = null;
COLS.forEach(function (x) { if (x.k === SORT.k) c = x; });
var numeric = c && (c.t === 'n' || c.t === 'i' || c.t === 'd');
out.sort(function (a, b) {
var x = a[SORT.k], y = b[SORT.k];
var res = numeric ? (num(x) - num(y)) : cmp(x, y);
return res * SORT.dir;
});
}
VIEW = out;
}

function renderTable() {
    var vc = visCols(), tb = el('tb');
    if (!vc.length) {
        tb.innerHTML = '<tbody><tr><td class=\'tb-empty\'>No columns selected. Please choose columns from the Columns menu.</td></tr></tbody>';
        renderFoot(0);
        return;
    }

    var h = '<thead><tr>';
    h += '<th style=\'width:40px;text-align:center;\'>No</th>';
    vc.forEach(function (c) {
        var on = SORT.k === c.k;
        h += '<th data-k=\'' + c.k + '\' class=\'' + (on ? 'sorted' : '') + '\' title=\'Click to sort\'>' + esc(c.h) +
             '<span class=\'si\'>' + (on ? (SORT.dir > 0 ? '&#9650;' : '&#9660;') : '&#9650;&#9660;') + '</span></th>';
    });
    h += '</tr></thead><tbody>';

    var pages = Math.max(1, Math.ceil(VIEW.length / PSIZE));
    if (PAGE > pages) PAGE = pages;
    var s = (PAGE - 1) * PSIZE, e = Math.min(VIEW.length, s + PSIZE);

    if (!VIEW.length) {
        h += '<tr><td class=\'tb-empty\' colspan=\'' + (vc.length + 1) + '\'>No data available for the selected filters</td></tr>';
    }

    for (var i = s; i < e; i++) {
        var r = VIEW[i];
        h += '<tr>';
        h += '<td class=\'c\' style=\'font-weight:600;color:#64748b;\'>' + (i + 1) + '</td>';
        for (var j = 0; j < vc.length; j++) {
            var c = vc[j], tx = cellText(r, c);
            var cls = (c.t === 'n' ? 'n' : (c.a === 'c' || c.t === 'i' ? 'c' : '')) + (c.st ? ' ' + stCls(tx) : '');
            h += '<td class=\'' + cls + '\' data-r=\'' + i + '\' data-k=\'' + c.k + '\' title=\'' + esc(tx) + '\'>' + esc(tx) + '</td>';
        }
        h += '</tr>';
    }
    h += '</tbody><tfoot><tr>';

    var tot = {};
    vc.forEach(function (c) { if (c.sum) tot[c.k] = 0; });
    for (var t = 0; t < VIEW.length; t++) { for (var k in tot) tot[k] += VIEW[t][k] || 0; }

    h += '<td></td>';
    vc.forEach(function (c, j) {
        if (c.sum) h += '<td class=\'n\'>' + fmtN(tot[c.k], 2) + '</td>';
        else h += '<td>' + (j === 0 ? 'Total' : '') + '</td>';
    });
    h += '</tr></tfoot>';

    tb.innerHTML = h;
    renderFoot(pages);
}

function renderFoot(pages) {
var n = VIEW.length, s = n ? (PAGE - 1) * PSIZE + 1 : 0, e = Math.min(n, PAGE * PSIZE);
el('tbInfo').textContent = 'Showing ' + fmtN(s, 0) + '–' + fmtN(e, 0) + ' of ' + fmtN(n, 0) + ' records';
var h = '<button type=\'button\' data-p=\'' + (PAGE - 1) + '\'' + (PAGE <= 1 ? ' disabled' : '') + '>&#8249;</button>';
var list = [], P = pages;
if (P <= 7) { for (var i = 1; i <= P; i++) list.push(i); }
else {
list.push(1);
var a = Math.max(2, PAGE - 1), b = Math.min(P - 1, PAGE + 1);
if (PAGE <= 3) { a = 2; b = 5; }
if (PAGE >= P - 2) { a = P - 4; b = P - 1; }
if (a > 2) list.push('...');
for (var j = a; j <= b; j++) list.push(j);
if (b < P - 1) list.push('...');
list.push(P);
}
list.forEach(function (p) {
if (p === '...') h += '<span class=\'dots\'>...</span>';
else h += '<button type=\'button\' data-p=\'' + p + '\' class=\'' + (p === PAGE ? 'on' : '') + '\'>' + p + '</button>';
});
h += '<button type=\'button\' data-p=\'' + (PAGE + 1) + '\'' + (PAGE >= P ? ' disabled' : '') + '>&#8250;</button>';
el('tbPg').innerHTML = h;
}

function renderColChooser() {
var h = '';
COLS.forEach(function (c) {
var on = !HIDE[c.k];
h += '<div class=\'ms-opt' + (on ? ' is-on' : '') + '\' data-cc=\'' + c.k + '\'><input type=\'checkbox\' tabindex=\'-1\'' + (on ? ' checked' : '') + '><span class=\'t\'>' + esc(c.h) + '</span></div>';
});
el('ccList').innerHTML = h;
var nv = visCols().length;
el('ccLbl').textContent = nv === COLS.length ? 'All Columns' : nv + ' Columns';
el('ccBtn').classList.toggle('is-active', nv !== COLS.length);
}

var toastT = null;
function toast(msg) {
var t = el('toast');
t.textContent = msg; t.classList.add('on');
clearTimeout(toastT); toastT = setTimeout(function () { t.classList.remove('on'); }, 1600);
}

function showCopyBox(txt) {
var ta = el('cpmTa');
ta.value = txt; el('cpm').classList.add('on');
ta.focus(); ta.select();
}

function copyText(txt, label) {
var ok = false;
try {
var ta = document.createElement('textarea');
ta.value = txt; ta.setAttribute('readonly', '');
ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.left = '0'; ta.style.opacity = '0';
document.body.appendChild(ta);
ta.focus(); ta.select();
ok = document.execCommand('copy');
document.body.removeChild(ta);
} catch (e) { ok = false; }
if (ok) { toast(label); return; }
if (navigator.clipboard && navigator.clipboard.writeText) {
navigator.clipboard.writeText(txt).then(function () { toast(label); }, function () { showCopyBox(txt); });
return;
}
showCopyBox(txt);
}

function copyCell(td) {
var r = VIEW[+td.getAttribute('data-r')], k = td.getAttribute('data-k'), c = null;
COLS.forEach(function (x) { if (x.k === k) c = x; });
if (!r || !c) return;
var prev = document.querySelectorAll('.tb td.cp');
for (var i = 0; i < prev.length; i++) prev[i].classList.remove('cp');
td.classList.add('cp');
var v = rawText(r, c);
copyText(v, 'Copied: ' + (v === '' ? '(Blank)' : v));
}

function copyRow(td) {
var r = VIEW[+td.getAttribute('data-r')];
if (!r) return;
var vc = visCols();
copyText(vc.map(function (c) { return rawText(r, c); }).join('\t'), 'Copied 1 row');
}

function copyTable() {
var vc = visCols();
if (!vc.length || !VIEW.length) { toast('No data available to copy'); return; }
var lines = [vc.map(function (c) { return c.h; }).join('\t')];
for (var i = 0; i < VIEW.length; i++) {
var r = VIEW[i];
lines.push(vc.map(function (c) { return rawText(r, c).replace(/[\t\r\n]+/g, ' '); }).join('\t'));
}
copyText(lines.join('\r\n'), 'Copied ' + fmtN(VIEW.length, 0) + ' rows');
}

// ================= MAPPING LOGO HOLDING GROUP =================
var HOLDING_LOGOS = {
    'MCG': 'https://i.ibb.co/C1HHKQS/MCG.png',
    'MBM': 'https://i.ibb.co/7nwFp7Z/MBMA.png',
    'MGR': 'https://i.ibb.co.com/VpCH8NKK/MGR.png'
};

var COMPANY_TO_HOLDING = {
    // --- HOLDING MBM ---
    'mtu': 'MBM', 'mti': 'MBM', 'merdeka tsingshan indonesia': 'MBM', 'pt merdeka tsingshan indonesia': 'MBM',
    'mtib': 'MBM', 'mtibi': 'MBM', 'ikip': 'MBM', 'csid': 'MBM', 'zhn': 'MBM', 'bsid': 'MBM', 'abp': 'MBM',
    'hnmi': 'MBM', 'sci': 'MBM', 'scm': 'MBM', 'mbm': 'MBM', 'mbma': 'MBM', 'jim': 'MBM', 'jpi': 'MBM',
    'mim': 'MBM', 'deg': 'MBM', 'gar': 'MBM', 'cbm': 'MBM', 'apk': 'MBM', 'wim': 'MBM', 'ham': 'MBM', 'tsp': 'MBM',

    // --- HOLDING MCG ---
    'b00': 'MCG', 'mcg': 'MCG', 'merdeka copper gold': 'MCG', 'pt merdeka copper gold tbk': 'MCG',
    'b02': 'MCG', 'bsi': 'MCG', 'bumi suksesindo': 'MCG', 'pt bumi suksesindo': 'MCG',
    'btr': 'MCG', 'bkp': 'MCG', 'mms': 'MCG', 'mts': 'MCG', 'motl': 'MCG', 'mosl': 'MCG',
    'sgt': 'MCG', 'alf': 'MCG', 'sjs': 'MCG', 'isc': 'MCG',

    // --- HOLDING MGR ---
    'mgr': 'MGR', 'merdeka gold resource': 'MGR', 'pt merdeka gold resource tbk': 'MGR',
    'mmn': 'MGR', 'gsm': 'MGR', 'p08': 'MGR', 'pets': 'MGR', 'p06': 'MGR', 'pbt': 'MGR',
    'p09': 'MGR', 'pbj': 'MGR', 'pin': 'MGR', 'btp': 'MGR', 'mmi': 'MGR', 'ela': 'MGR',
    'pbl': 'MGR', 'hilcon': 'MGR', 'sss': 'MGR'
};

function getHoldingLogoUrl(companyStr) {
    if (!companyStr) return '';
    var raw = String(companyStr).toLowerCase().trim();
    var clean = raw.replace(/^pt\s+/i, '').trim();

    var holding = COMPANY_TO_HOLDING[clean] || COMPANY_TO_HOLDING[raw];

    if (!holding) {
        var code = (COMP_NAME_TO_CODE[clean] || COMP_NAME_TO_CODE[raw] || '').toLowerCase();
        if (code) holding = COMPANY_TO_HOLDING[code];
    }

    if (!holding) {
        if (raw.indexOf('tsingshan') >= 0 || raw.indexOf('battery') >= 0 || raw.indexOf('konawe') >= 0 || raw.indexOf('smelter') >= 0 || raw.indexOf('nickel') >= 0) {
            holding = 'MBM';
        } else if (raw.indexOf('copper') >= 0 || raw.indexOf('suksesindo') >= 0 || raw.indexOf('tembaga') >= 0 || raw.indexOf('wetar') >= 0) {
            holding = 'MCG';
        } else if (raw.indexOf('gold') >= 0 || raw.indexOf('pani') >= 0 || raw.indexOf('gorontalo') >= 0 || raw.indexOf('puncak emas') >= 0) {
            holding = 'MGR';
        }
    }

    return HOLDING_LOGOS[holding] || HOLDING_LOGOS['MBM'];
}

function renderHeaderLogo(ks) {
    var box = el('hdLogoBox');
    if (!box) return;

    if (!ks || ks.length === 0 || ks.length > 1) {
        box.innerHTML =
            '<div class=\'hd-logos even\'>' +
                '<img src=\'https://i.ibb.co.com/C1HHKQS/MCG.png\' title=\'MCG\' />' +
                '<img src=\'https://i.ibb.co.com/7nwFp7Z/MBMA.png\' title=\'MBM\' />' +
                '<img src=\'https://i.ibb.co.com/VpCH8NKK/MGR.png\' title=\'MGR\' />' +
            '</div>';
    } else {
        var singleName = ks[0];
        var imgUrl = getHoldingLogoUrl(singleName);
        box.innerHTML =
            '<div class=\'hd-logos\'>' +
                '<img src=\'' + imgUrl + '\' title=\'' + esc(singleName) + '\' />' +
            '</div>';
    }
}

function shadeHex(hex, f) {
    var h = String(hex).replace('#', '').trim();
    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
    if (!/^[0-9a-fA-F]{6}$/.test(h)) return null;
    var n = parseInt(h, 16), r = n >> 16, g = (n >> 8) & 255, b = n & 255;
    function c(x) { return Math.round(f < 0 ? x * (1 + f) : x + (255 - x) * f); }
    return 'rgb(' + c(r) + ',' + c(g) + ',' + c(b) + ')';
}

function setHeaderColor(ks) {
    var hd = document.querySelector('.hd');
    if (!hd) return;
    var col = null;
    for (var i = 0; i < ks.length; i++) {
        var c = COMP_COLOR[ks[i]];
        if (!c || (col && c.toLowerCase() !== col.toLowerCase())) { col = null; break; }
        col = c;
    }
    var dark = col ? shadeHex(col, -0.35) : null, light = col ? shadeHex(col, 0.15) : null;
    if (dark && light) { hd.style.setProperty('--hd1', dark); hd.style.setProperty('--hd2', light); }
    else { hd.style.removeProperty('--hd1'); hd.style.removeProperty('--hd2'); }
}

function renderHeader() {
    var sel = FS.sbCompany;
    var isAll = (!sel || !sel.n || (TOTAL_MASTER_COMP > 0 && sel.n >= TOTAL_MASTER_COMP));
    var t = 'All Companies', ks = [];

    if (!isAll && sel && sel.n) {
        ks = Object.keys(sel.v);
        t = ks.length === 1 ? ks[0] : (ks.length === 2 ? ks.join(', ') : ks.length + ' Companies');
        el('hdEntity').title = ks.join(', ');
    } else {
        el('hdEntity').title = t;
    }

    el('hdEntity').textContent = t;
    setHeaderColor(ks);
    renderHeaderLogo(ks);
}

function applyFilters() { refreshSlicers(); buildView(); renderTable(); renderHeader(); }
function refreshTable() { buildView(); renderTable(); renderHeader(); }

function resetFilters() {
    FS = {}; DSEL = { y: 0, m: 0, d: 0 }; cachedDate = null; setTodayBtn(false);
    SLICERS.forEach(function (s) { var inp = el(s.id).querySelector('.ms-search'); if (inp) inp.value = ''; });
    QRY = ''; el('tbSearch').value = ''; SORT = { k: '', dir: 1 }; HIDE = Object.create(null); PAGE = 1;
    PSIZE = 999999; el('tbSize').value = '999999';
    closeAll(); renderColChooser();
    renderDate(); applyFilters();
}

function init() {
    if (INITED) return;
    INITED = true;

    parseData();
    buildSlicers();
    applyPbiFilters();

    // Default: Year / Month / Day = All, Today = Off, Rows = All
    DSEL = { y: 0, m: 0, d: 0 };
    setTodayBtn(false);
    PSIZE = 999999; el('tbSize').value = '999999';

    renderDate();
    renderColChooser();

    var sT = null;
    document.onclick = function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var b = t.closest('.ms-btn'); if (b) { msToggleOpen(b.getAttribute('data-sl')); return; }
        var c = t.closest('.ms-clear'); if (c) { clearSlicer(c.getAttribute('data-sl')); return; }
        var o = t.closest('.ms-opt[data-sl]'); if (o) { toggleOpt(o.getAttribute('data-sl'), +o.getAttribute('data-i')); return; }
        if (t.closest('#ccBtn')) { var box = el('ccBox'); if (MS_OPEN) msToggleOpen(MS_OPEN); box.classList.toggle('open'); return; }
        var co = t.closest('.ms-opt[data-cc]');
        if (co) { var k = co.getAttribute('data-cc'); if (HIDE[k]) delete HIDE[k]; else HIDE[k] = 1; renderColChooser(); refreshTable(); return; }
        if (t.closest('#ccAll')) { HIDE = Object.create(null); renderColChooser(); refreshTable(); return; }
        if (t.closest('#ccNone')) { COLS.forEach(function (x) { HIDE[x.k] = 1; }); renderColChooser(); refreshTable(); return; }
        if (t.closest('#btnCopyTbl')) { copyTable(); return; }
        if (t.closest('#cpmX') || t.id === 'cpm') { el('cpm').classList.remove('on'); return; }
        var th = t.closest('.tb th');
        if (th) { var sk = th.getAttribute('data-k'); if (!sk) return; if (SORT.k === sk) { if (SORT.dir > 0) SORT.dir = -1; else SORT = { k: '', dir: 1 }; } else SORT = { k: sk, dir: 1 }; refreshTable(); return; }
        var td = t.closest('.tb tbody td[data-k]');
        if (td) { if (e.ctrlKey || e.metaKey) copyRow(td); else copyCell(td); return; }
        var pg = t.closest('.pg button');
        if (pg && !pg.disabled) { PAGE = +pg.getAttribute('data-p'); renderTable(); el('tbWrap').scrollTop = 0; return; }
        if (!t.closest('.ms') && !t.closest('.cc')) closeAll();
    };

    document.oninput = function (e) {
        var t = e.target;
        if (!t) return;
        if (t.classList && t.classList.contains('ms-search')) { var s = getSl(t.getAttribute('data-sl')); if (s) renderOpts(s); return; }
        if (t.id === 'tbSearch') { clearTimeout(sT); sT = setTimeout(function () { QRY = t.value.trim(); PAGE = 1; refreshTable(); }, 250); }
    };

    ['sbYr', 'sbMo', 'sbDy'].forEach(function (id) { el(id).onchange = onDateChange; });
    el('tbSize').onchange = function () { PSIZE = +this.value || 25; PAGE = 1; renderTable(); };
    el('btnToday').onclick = toggleToday;
    el('btnReset').onclick = resetFilters;

    applyFilters();
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
</body>
</html>
"
